  }

  #hours .monthly-weekdays .weekday { text-align: center; padding: 10px 4px; font-size: 0.85rem; font-weight: 500; color: var(--color-text-muted); }
  #hours .monthly-weekdays .weekday.sunday { color: #e05a5a; }
