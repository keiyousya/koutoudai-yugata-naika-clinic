---
import { LINE_ADD_FRIEND_URL } from "../config/line";
---

<div class="fixed-line" id="fixedLine">
  {/* SPのみ表示。右端に寄せたタブを開閉する */}
  <button type="button" class="fixed-line-toggle" id="fixedLineToggle" aria-expanded="true" aria-controls="fixedLineButton" aria-label="LINE予約ボタンをたたむ">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  <a href={LINE_ADD_FRIEND_URL} target="_blank" rel="noopener noreferrer" class="fixed-line-button" id="fixedLineButton">
    <svg class="line-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
    </svg>
    <span class="button-text">LINE予約<br class="pc-break" />はこちら</span>
  </a>
</div>
<div class="fixed-line-spacer" aria-hidden="true"></div>

<style>
  .fixed-line-button {
    position: fixed;
    right: 0;
    top: 0;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 120px;
    height: 140px;
    background: #06C755;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
    line-height: 1.5;
    border-radius: 0 0 0 24px;
    transition: background 0.2s;
    box-shadow: -2px 2px 10px rgba(0, 0, 0, 0.15);
  }

  .fixed-line-button:hover {
    background: #05b34c;
  }

  .line-icon {
    width: 36px;
    height: 36px;
  }

  .fixed-line-toggle {
    display: none;
  }

  /* SPの固定ボタンでフッター末尾が隠れないよう、ページ末尾に余白を確保する */
  .fixed-line-spacer {
    display: none;
    height: calc(64px + env(safe-area-inset-bottom));
  }

  /* SPは画面右下の端に寄せたタブにする。たたむとLINEアイコンだけ残る */
  @media (max-width: 854px) {
    .fixed-line {
      position: fixed;
      right: 0;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 1001;
      display: flex;
      align-items: stretch;
      height: 44px;
      border-radius: 22px 0 0 22px;
      background: #06C755;
      box-shadow: 0 3px 12px rgba(0, 0, 0, 0.2);
      overflow: hidden;
    }

    .fixed-line-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      padding: 0 0 0 4px;
      border: 0;
      background: transparent;
      color: rgba(255, 255, 255, 0.85);
      cursor: pointer;
    }

    .fixed-line-toggle svg {
      transition: transform 0.25s;
    }

    .fixed-line-button {
      position: static;
      flex-direction: row;
      gap: 6px;
      width: auto;
      height: auto;
      padding: 0 14px 0 4px;
      font-size: 0.85rem;
      border-radius: 0;
      box-shadow: none;
    }

    .line-icon {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }

    .button-text {
      max-width: 10em;
      overflow: hidden;
      white-space: nowrap;
      transition: max-width 0.25s, opacity 0.2s;
    }

    .pc-break {
      display: none;
    }

    .fixed-line.is-collapsed .button-text {
      max-width: 0;
      opacity: 0;
    }

    .fixed-line.is-collapsed .fixed-line-button {
      padding-right: 10px;
      gap: 0;
    }

    .fixed-line.is-collapsed .fixed-line-toggle svg {
      transform: rotate(180deg);
    }

    .fixed-line-spacer {
      display: block;
    }
  }
</style>

<script>
  // たたんだ状態は閲覧者ごとに覚えておく（使えない環境では毎回開いた状態で出す）
  const STORAGE_KEY = "fixedLineCollapsed";
  const wrapper = document.getElementById("fixedLine");
  const toggle = document.getElementById("fixedLineToggle");

  const setCollapsed = (collapsed: boolean) => {
    wrapper?.classList.toggle("is-collapsed", collapsed);
    toggle?.setAttribute("aria-expanded", String(!collapsed));
    toggle?.setAttribute("aria-label", collapsed ? "LINE予約ボタンを広げる" : "LINE予約ボタンをたたむ");
  };

  try {
    setCollapsed(sessionStorage.getItem(STORAGE_KEY) === "1");
  } catch {}

  toggle?.addEventListener("click", () => {
    const collapsed = !wrapper?.classList.contains("is-collapsed");
    setCollapsed(collapsed);
    try {
      sessionStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
    } catch {}
  });
</script>
