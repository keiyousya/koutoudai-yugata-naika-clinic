---
import { LINE_ADD_FRIEND_URL } from "../config/line";
import PhoneNumber from "./PhoneNumber.astro";

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-info">
        <h3 class="footer-logo">勾当台夕方内科クリニック</h3>
        <address class="footer-address">
          〒980-0803<br />
          宮城県仙台市青葉区国分町3丁目8-1<br />
          勾当台ビル 4階
        </address>
        <p class="footer-tel">TEL <PhoneNumber /></p>
        <div class="footer-actions">
          <a href="https://maps.google.com/?q=勾当台夕方内科クリニック" target="_blank" rel="noopener noreferrer" class="map-btn">
            マップを見る
          </a>
          <a href={LINE_ADD_FRIEND_URL} target="_blank" rel="noopener noreferrer" class="line-btn">
            LINEで予約
          </a>
        </div>
      </div>

      <div class="footer-nav">
        <h4>メニュー</h4>
        <ul>
          <li><a href="/#about">当院について</a></li>
          <li><a href="/#hours">診療時間</a></li>
          <li><a href="/#reservation">ご予約</a></li>
          <li><a href="/#access">アクセス</a></li>
          <li><a href="/doctor">院長紹介</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        <a href="/privacy">個人情報の取扱いについて</a>
        <a href="/tokushoho">特定商取引法に基づく表記</a>
        {/* TODO(2026-08): オンライン診療ページを8月に公開する際、下記リンクのコメントアウトを解除する */}
        {/*
        <span class="footer-legal-sep" aria-hidden="true">|</span>
        <a href="/online-medical">オンライン診療について</a>
        */}
      </p>
      <p class="copyright">
        &copy; {currentYear} 勾当台夕方内科クリニック
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    color: var(--color-text);
    padding: 56px 0 28px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: center;
    gap: 80px;
    margin-bottom: 48px;
  }

  .footer-nav h4 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .footer-logo {
    font-family: var(--font-brand);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 14px;
  }

  .footer-address {
    font-style: normal;
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }

  .map-btn {
    display: inline-block;
    padding: 8px 20px;
    background: white;
    color: var(--color-turquoise);
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--color-turquoise);
    border-radius: 20px;
    transition: background 0.2s;
  }

  .map-btn:hover {
    background: var(--color-turquoise-bg);
  }

  .footer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .line-btn {
    display: inline-block;
    padding: 8px 20px;
    background: #06c755;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid #06c755;
    border-radius: 20px;
    transition: opacity 0.2s;
  }

  .line-btn:hover {
    opacity: 0.85;
  }

  .footer-nav ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--color-turquoise);
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
    text-align: center;
  }

  .footer-legal {
    margin-bottom: 12px;
  }

  .footer-legal a {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    transition: color 0.2s;
    white-space: nowrap;
    margin: 0 8px;
  }

  .footer-legal a:hover {
    color: var(--color-turquoise);
  }

  .footer-legal-sep {
    display: inline-block;
    margin: 0 10px;
    color: #ccc;
    font-size: 0.8rem;
  }

  .footer-tel {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 12px;
  }

  .copyright {
    font-size: 0.8rem;
    color: #aaa;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 32px;
      text-align: center;
    }

    .footer-actions {
      justify-content: center;
    }

    .footer-nav ul {
      display: inline-grid;
      grid-template-columns: auto auto;
      gap: 10px 32px;
      text-align: left;
    }
  }
</style>
