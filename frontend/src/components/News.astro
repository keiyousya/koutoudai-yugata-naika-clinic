---
---

<section id="news" class="section news">
  <div class="container">
    <h2 class="section-title">お知らせ</h2>
    <div class="news-content">
      <ul class="news-list" id="newsList">
        <!-- スケルトン -->
        {Array.from({ length: 3 }).map(() => (
          <li class="news-item news-item--skeleton">
            <span class="news-date"><span class="skeleton skeleton-date"></span></span>
            <span class="news-text"><span class="skeleton skeleton-text"></span></span>
          </li>
        ))}
      </ul>
      <div class="news-link">
        <a href="/news">すべてのお知らせを見る →</a>
      </div>
    </div>
  </div>
</section>

<script>
  const PROCYON_BASE = import.meta.env.PUBLIC_PROCYON_BASE_URL || 'https://api.procyon.helix.keiyousya.com';
  const PROCYON_TENANT = import.meta.env.PUBLIC_PROCYON_TENANT || 'koutoudai-yugata-naika';
  const API_URL = `${PROCYON_BASE}/${PROCYON_TENANT}/v1/notices`;
  // APIが応答しないときにスケルトンを出し続けないよう、5秒で打ち切ってエラー表示にする
  const FETCH_TIMEOUT_MS = 5000;

  interface NoticeEntry {
    id: string;
    title: string;
    content: string;
    publishStartDate: string;
    createdAt: string;
    updatedAt: string;
  }

  interface GetNoticesResponse {
    notices: NoticeEntry[];
    hasMore: boolean;
    nextCursor?: string;
  }

  function formatDate(dateStr: string): string {
    return dateStr.replace(/-/g, '.');
  }

  async function loadNews() {
    const list = document.getElementById('newsList');
    if (!list) return;

    try {
      const res = await fetch(`${API_URL}?pageSize=3`, { signal: AbortSignal.timeout(FETCH_TIMEOUT_MS) });
      if (!res.ok) throw new Error('fetch failed');
      const data: GetNoticesResponse = await res.json();

      list.innerHTML = data.notices.map(notice => `
        <li class="news-item">
          <a href="/news/detail/?id=${notice.id}" class="news-item-link">
            <span class="news-date">${formatDate(notice.publishStartDate)}</span>
            <span class="news-text">${notice.title}</span>
            <span class="news-arrow">
              <span class="arrow-text">詳しくはこちら</span>
              <span class="arrow-symbol">→</span>
            </span>
          </a>
        </li>
      `).join('');
    } catch {
      list.classList.add('news-list--status');
        list.innerHTML = '<li class="news-status" role="status"><svg class="news-status-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span class="news-status-title">お知らせを読み込めませんでした</span><span class="news-status-note">時間をおいて再度お試しください</span></li>';
    }
  }

  loadNews();
</script>

<style is:global>
  #news {
    background: white;
    padding-top: 48px;
    padding-bottom: 48px;
  }

  #news .news-content {
    max-width: 720px;
    margin: 0 auto;
  }

  #news .news-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  #news .news-item {
    border-bottom: 1px solid var(--color-border);
  }

  #news .news-item-link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  #news .news-item-link:hover {
    background: var(--color-turquoise-bg);
  }

  #news .news-date {
    flex-shrink: 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  #news .news-text {
    flex: 1;
    font-size: 0.9rem;
    color: var(--color-navy);
    font-weight: 500;
    line-height: 1.7;
  }

  /* 読み込み失敗時。一覧の罫線は消して、グレーの枠で控えめに出す */
  #news .news-list--status {
    border-top: none;
  }

  #news .news-status {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 28px 20px;
    background: #f9f9f9;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: center;
  }

  #news .news-status-icon {
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  #news .news-status-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  #news .news-status-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  #news .news-arrow {
    flex-shrink: 0;
    color: var(--color-turquoise);
    opacity: 0.6;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  #news .arrow-text {
    display: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  #news .arrow-symbol {
    font-size: 1rem;
  }

  #news .news-item-link:hover .news-arrow {
    opacity: 1;
  }

  #news .news-link {
    text-align: center;
    margin-top: 20px;
  }

  #news .news-link a {
    color: var(--color-turquoise);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  #news .news-link a:hover {
    opacity: 0.8;
  }

  /* スケルトン */
  #news .news-item--skeleton {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 8px;
  }

  #news .skeleton {
    display: inline-block;
    background: #eee;
    border-radius: 4px;
    animation: news-skeleton-pulse 1.5s ease-in-out infinite;
  }

  #news .skeleton-date {
    width: 5.5em;
    height: 0.78rem;
  }

  #news .skeleton-text {
    width: 16em;
    height: 0.9rem;
  }

  @keyframes news-skeleton-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (max-width: 768px) {
    #news {
      padding-top: 36px;
      padding-bottom: 36px;
    }

    #news .news-item-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 14px 16px;
    }

    #news .news-item--skeleton {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 14px 16px;
    }

    #news .news-date {
      font-size: 0.8rem;
    }

    #news .news-text {
      font-size: 0.9rem;
    }

    #news .news-arrow {
      margin-top: 0;
      opacity: 1;
      align-self: flex-end;
    }

    #news .arrow-text {
      display: inline;
    }
  }
</style>
