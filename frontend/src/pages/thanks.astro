---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="送信完了 | 勾当台夕方内科クリニック" noindex={true}>
  <Header />
  <main class="page-main">
    <section class="section thanks-section">
      <div class="container">
        <div class="thanks-card">
          <div class="thanks-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h1>送信が完了しました</h1>
          <p>
            ご応募いただきありがとうございます。<br />
            内容を確認の上、担当者よりご連絡いたします。
          </p>
        </div>

        <div class="detail-back">
          <a href="/" class="back-button">ホームに戻る</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .thanks-section {
    background: white;
    min-height: 60vh;
    display: flex;
    align-items: center;
    padding-top: 100px;
  }

  .thanks-card {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    background: var(--color-turquoise-bg);
    border: 1px solid var(--color-turquoise);
    border-radius: 16px;
    padding: 48px 40px;
  }

  .thanks-icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    background: white;
    border: 1px solid var(--color-turquoise);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-turquoise);
  }

  h1 {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }

  p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .detail-back {
    text-align: center;
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    padding: 12px 32px;
    background: white;
    border: 1px solid var(--color-navy);
    border-radius: 24px;
    color: var(--color-navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .back-button:hover {
    background: var(--color-navy);
    color: white;
  }

  @media (max-width: 768px) {
    .thanks-card {
      padding: 36px 24px;
    }

    h1 {
      font-size: 1.15rem;
    }
  }
</style>
