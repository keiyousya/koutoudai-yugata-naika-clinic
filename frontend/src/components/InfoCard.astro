---
import HealthIcon from "./HealthIcon.astro";

interface Props {
  icon?: string;
  title: string;
  variant?: "turquoise" | "outlined" | "coral" | "outlined-coral";
  collapsible?: boolean;
}

const { icon, title, variant = "turquoise", collapsible = false } = Astro.props;
---

{collapsible ? (
  <div class:list={["info-card", "info-card--collapsible", `info-card--${variant}`]}>
    <button type="button" class="info-card__header info-card__toggle" aria-expanded="false">
      {icon && (
        <span class="info-card__icon">
          <HealthIcon name={icon} size={28} />
        </span>
      )}
      <h4 class="info-card__title">{title}</h4>
      <span class="info-card__chevron" />
    </button>
    <div class="info-card__collapse">
      <div class="info-card__body">
        <slot />
      </div>
    </div>
  </div>
) : (
  <div class:list={["info-card", `info-card--${variant}`]}>
    <div class="info-card__header">
      {icon && (
        <span class="info-card__icon">
          <HealthIcon name={icon} size={28} />
        </span>
      )}
      <h4 class="info-card__title">{title}</h4>
    </div>
    <div class="info-card__body">
      <slot />
    </div>
  </div>
)}

<style>
  .info-card {
    border-radius: 16px;
    padding: 28px 24px;
  }

  .info-card--turquoise {
    background: var(--color-turquoise-bg);
    border: 1px solid var(--color-turquoise);
  }

  .info-card--outlined {
    background: white;
    border: 1px solid var(--color-turquoise);
  }

  .info-card--outlined-coral {
    background: white;
    border: 1px solid var(--color-coral);
  }

  .info-card--coral {
    background: var(--color-coral-bg);
    border: 1px solid var(--color-coral);
  }

  .info-card__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  /* collapsible */
  .info-card__toggle {
    all: unset;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    cursor: pointer;
    box-sizing: border-box;
  }

  .info-card--collapsible {
    padding: 16px 20px;
  }

  .info-card--collapsible .info-card__header {
    margin-bottom: 0;
  }

  .info-card__chevron {
    margin-left: auto;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .info-card--coral .info-card__chevron,
  .info-card--outlined-coral .info-card__chevron {
    background: white;
  }

  .info-card--turquoise .info-card__chevron,
  .info-card--outlined .info-card__chevron {
    background: white;
  }

  .info-card__chevron::after {
    content: "";
    display: block;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-coral);
    border-bottom: 2px solid var(--color-coral);
    transform: rotate(45deg);
    margin-top: -3px;
  }

  .info-card--turquoise .info-card__chevron::after,
  .info-card--outlined .info-card__chevron::after {
    border-color: var(--color-turquoise);
  }

  .info-card--collapsible.is-open .info-card__chevron {
    transform: rotate(180deg);
  }

  .info-card__collapse {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .info-card--collapsible.is-open .info-card__collapse {
    grid-template-rows: 1fr;
  }

  .info-card__collapse > .info-card__body {
    overflow: hidden;
  }

  .info-card--collapsible.is-open .info-card__collapse > .info-card__body {
    padding-top: 12px;
  }

  .info-card__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
  }

  .info-card--turquoise .info-card__icon {
    background: white;
    color: var(--color-turquoise);
  }

  .info-card--outlined .info-card__icon {
    background: var(--color-turquoise-bg);
    color: var(--color-turquoise);
  }

  .info-card--outlined-coral .info-card__icon {
    background: var(--color-coral-bg);
    color: var(--color-coral);
  }

  .info-card--coral .info-card__icon {
    background: white;
    color: var(--color-coral);
  }

  .info-card__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.4;
  }

  .info-card__body :global(p) {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .info-card__body :global(p strong) {
    color: var(--color-navy);
    font-weight: 700;
  }

  .info-card__body :global(.condition-list) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .info-card__body :global(.condition-tag) {
    display: inline-block;
    padding: 6px 16px;
    background: white;
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: 20px;
  }

  .info-card--turquoise .info-card__body :global(.condition-tag),
  .info-card--outlined .info-card__body :global(.condition-tag) {
    color: var(--color-turquoise);
    border: 1px solid var(--color-turquoise);
  }

  .info-card--coral .info-card__body :global(.condition-tag),
  .info-card--outlined-coral .info-card__body :global(.condition-tag) {
    color: var(--color-coral);
    border: 1px solid var(--color-coral);
  }

  .info-card__body :global(.info-card__description) {
    margin-bottom: 18px;
  }

  .info-card__body :global(.info-card__image) {
    display: block;
    width: 70%;
    max-width: 240px;
    height: auto;
    border-radius: 4px;
    margin: 0 auto 12px;
  }

  /* 遅延読み込み中のスケルトンを敷くための枠。サイズ指定は枠側が持つ */
  .info-card__body :global(.info-card__image-frame) {
    width: 70%;
    max-width: 240px;
    border-radius: 4px;
    overflow: hidden;
    margin: 0 auto 12px;
  }

  .info-card__body :global(.info-card__image-frame .info-card__image) {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .info-card__body :global(.info-card__device) {
    display: inline-block;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding-top: 10px;
    width: 100%;
  }

  .info-card__body :global(.info-card__note) {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-top: 10px;
  }

  .info-card__body :global(.info-card__link--inline) {
    color: var(--color-coral);
    font-weight: 600;
    text-decoration: underline;
    transition: opacity 0.2s;
  }

  .info-card__body :global(.info-card__link--inline:hover) {
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .info-card {
      padding: 22px 18px;
    }

    .info-card--collapsible {
      padding: 14px 16px;
    }

    .info-card__title {
      font-size: 0.9rem;
    }

    .info-card__body :global(.condition-tag) {
      font-size: 0.85rem;
      padding: 5px 12px;
    }
  }
</style>

<script>
  document.querySelectorAll('.info-card__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.info-card--collapsible')!;
      const isOpen = card.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });
</script>
