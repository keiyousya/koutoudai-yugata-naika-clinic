---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SubPageHeader from "../../components/SubPageHeader.astro";
import Footer from "../../components/Footer.astro";
---

<Layout
  title="お知らせ一覧 | 勾当台夕方内科クリニック"
  description="勾当台夕方内科クリニックからのお知らせ一覧。休診情報、新サービス開始のお知らせなど。"
>
  <Header />
  <main class="news-list-main">
    <SubPageHeader label="News" title="お知らせ" />

    <section class="news-list-content">
      <div class="container">
        <ul class="news-list" id="newsList">
          {Array.from({ length: 5 }).map(() => (
            <li class="news-item news-item--skeleton">
              <span class="news-date"><span class="skeleton skeleton-date"></span></span>
              <span class="news-text"><span class="skeleton skeleton-text"></span></span>
            </li>
          ))}
        </ul>
        <div class="load-more-sentinel" id="loadMoreSentinel" style="display: none;">
          <div class="spinner" aria-label="読み込み中"></div>
        </div>
      </div>
    </section>

    <section class="back-section">
      <div class="container">
        <div class="detail-back">
          <a href="/" class="back-button">ホームに戻る</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const PROCYON_BASE = import.meta.env.PUBLIC_PROCYON_BASE_URL || 'https://api.procyon.helix.keiyousya.com';
  const PROCYON_TENANT = import.meta.env.PUBLIC_PROCYON_TENANT || 'koutoudai-yugata-naika';
  const API_URL = `${PROCYON_BASE}/${PROCYON_TENANT}/v1/notices`;
  const PAGE_SIZE = 10;

  interface NoticeEntry {
    id: string;
    title: string;
    content: string;
    publishStartDate: string;
    createdAt: string;
    updatedAt: string;
  }

  interface GetNoticesResponse {
    notices: NoticeEntry[];
    hasMore: boolean;
    nextCursor?: string;
  }

  function formatDate(dateStr: string): string {
    return dateStr.replace(/-/g, '.');
  }

  function renderItems(notices: NoticeEntry[]): string {
    return notices.map(notice => `
      <li class="news-item">
        <a href="/news/detail/?id=${notice.id}" class="news-item-link">
          <span class="news-date">${formatDate(notice.publishStartDate)}</span>
          <span class="news-text">${notice.title}</span>
          <span class="news-arrow">
            <span class="arrow-text">詳しくはこちら</span>
            <span class="arrow-symbol">→</span>
          </span>
        </a>
      </li>
    `).join('');
  }

  const list = document.getElementById('newsList');
  const sentinel = document.getElementById('loadMoreSentinel');
  let nextCursor: string | undefined;
  let isFirstLoad = true;
  let isLoading = false;
  let hasMore = true;

  async function loadPage() {
    if (!list || isLoading || !hasMore) return;
    isLoading = true;

    try {
      const url = new URL(API_URL);
      url.searchParams.set('pageSize', String(PAGE_SIZE));
      if (nextCursor) url.searchParams.set('cursor', nextCursor);

      const res = await fetch(url.toString());
      if (!res.ok) throw new Error('fetch failed');
      const data: GetNoticesResponse = await res.json();

      if (isFirstLoad) {
        if (data.notices.length === 0) {
          list.innerHTML = '<li class="news-item"><span class="news-text news-empty">現在お知らせはありません</span></li>';
          hasMore = false;
          return;
        }
        list.innerHTML = renderItems(data.notices);
        isFirstLoad = false;
      } else {
        list.insertAdjacentHTML('beforeend', renderItems(data.notices));
      }

      nextCursor = data.nextCursor;
      hasMore = data.hasMore;

      if (sentinel) {
        sentinel.style.display = hasMore ? '' : 'none';
      }
    } catch {
      if (isFirstLoad) {
        list.innerHTML = '<li class="news-item"><span class="news-text news-error">お知らせの読み込みに失敗しました</span></li>';
      }
      hasMore = false;
      if (sentinel) sentinel.style.display = 'none';
    } finally {
      isLoading = false;
    }
  }

  // IntersectionObserver で sentinel が見えたら次ページを読み込む
  if (sentinel) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && hasMore && !isLoading) {
        loadPage();
      }
    }, { rootMargin: '200px' });
    observer.observe(sentinel);
  }

  loadPage();
</script>

<style is:global>
  .news-list-main {
    min-height: calc(100vh - 72px);
    background: white;
  }

  .news-list-main .news-list-content {
    padding: 0 0 80px;
  }

  .news-list-main .news-list-content .container {
    max-width: 800px;
  }

  .news-list-main .news-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  .news-list-main .news-item {
    border-bottom: 1px solid var(--color-border);
  }

  .news-list-main .news-item-link {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .news-list-main .news-item-link:hover {
    background: var(--color-turquoise-bg);
  }

  .news-list-main .news-date {
    flex-shrink: 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .news-list-main .news-text {
    flex: 1;
    font-size: 0.9rem;
    color: var(--color-navy);
    font-weight: 500;
    line-height: 1.7;
  }

  .news-list-main .news-empty,
  .news-list-main .news-error {
    color: var(--color-text-muted);
    font-weight: 400;
    padding: 20px 8px;
  }

  .news-list-main .news-arrow {
    flex-shrink: 0;
    color: var(--color-turquoise);
    opacity: 0.6;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .news-list-main .arrow-text {
    display: none;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .news-list-main .arrow-symbol {
    font-size: 1rem;
  }

  .news-list-main .news-item-link:hover .news-arrow {
    opacity: 1;
  }

  /* スケルトン */
  .news-list-main .news-item--skeleton {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 8px;
  }

  .news-list-main .skeleton {
    display: inline-block;
    background: #eee;
    border-radius: 4px;
    animation: news-list-skeleton-pulse 1.5s ease-in-out infinite;
  }

  .news-list-main .skeleton-date {
    width: 5.5em;
    height: 0.78rem;
  }

  .news-list-main .skeleton-text {
    width: 16em;
    height: 0.9rem;
  }

  @keyframes news-list-skeleton-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .news-list-main .load-more-sentinel {
    display: flex;
    justify-content: center;
    padding: 32px 0;
  }

  .news-list-main .spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-turquoise);
    border-radius: 50%;
    animation: news-spinner 0.7s linear infinite;
  }

  @keyframes news-spinner {
    to { transform: rotate(360deg); }
  }

  .news-list-main .back-section {
    background: white;
    padding: 40px 0 80px;
  }

  .news-list-main .detail-back {
    text-align: center;
    padding-top: 32px;
  }

  .news-list-main .back-button {
    display: inline-flex;
    align-items: center;
    padding: 12px 32px;
    background: white;
    border: 1px solid var(--color-navy);
    border-radius: 24px;
    color: var(--color-navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .news-list-main .back-button:hover {
    background: var(--color-navy);
    color: white;
  }

  @media (max-width: 768px) {
    .news-list-main .news-list-content {
      padding: 0 0 60px;
    }

    .news-list-main .news-item-link {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 14px 16px;
    }

    .news-list-main .news-item--skeleton {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 14px 16px;
    }

    .news-list-main .news-date {
      font-size: 0.8rem;
    }

    .news-list-main .news-text {
      font-size: 0.9rem;
    }

    .news-list-main .news-arrow {
      margin-top: 0;
      opacity: 1;
      align-self: flex-end;
    }

    .news-list-main .arrow-text {
      display: inline;
    }
  }
</style>
