---
import LineButton from "./LineButton.astro";
import AvailabilityLink from "./AvailabilityLink.astro";

interface Props {
  lines?: string[];
}

const { lines = [] } = Astro.props;
---

<div class="line-cta">
  {lines.length > 0 && (
    <p class="line-cta-text">
      {lines.map((line) => (
        <span class="cta-line">{line}</span>
      ))}
    </p>
  )}
  <LineButton />
  <div class="line-cta-availability">
    <AvailabilityLink />
  </div>
</div>

<style>
  .line-cta {
    text-align: center;
  }

  .line-cta-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 2;
    margin-bottom: 28px;
  }

  .cta-line {
    display: inline;
  }

  .line-cta-availability {
    margin-top: 20px;
  }

  @media (max-width: 768px) {
    .cta-line {
      display: block;
    }
  }
</style>
