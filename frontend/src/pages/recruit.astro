---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Access from "../components/Access.astro";
import Footer from "../components/Footer.astro";
import RecruitVisual from "../components/RecruitVisual.astro";

const hiringOrganization = {
  "@type": "Organization",
  "name": "勾当台夕方内科クリニック",
  "sameAs": "https://koutoudai-yugata-naika.clinic",
  "logo": "https://koutoudai-yugata-naika.clinic/apple-touch-icon.png"
};
const jobLocation = {
  "@type": "Place",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "国分町3丁目8-1 勾当台ビル4階",
    "addressLocality": "仙台市青葉区",
    "addressRegion": "宮城県",
    "postalCode": "980-0803",
    "addressCountry": "JP"
  }
};
const hourlySalary = (minValue: number, maxValue?: number) => ({
  "@type": "MonetaryAmount",
  "currency": "JPY",
  "value": { "@type": "QuantitativeValue", minValue, maxValue, "unitText": "HOUR" }
});

const jobPostings = [
  {
    "@context": "https://schema.org/",
    "@type": "JobPosting",
    "title": "看護師",
    "description": "勾当台夕方内科クリニックで看護師を募集しています。採血・点滴・注射・予防接種・検査など、外来診療の補助を担当していただきます。勤務時間は平日17:00〜21:00、土日14:00〜21:00、週1回から。時給は正看護師1,900円・准看護師1,600円、交通費支給（月額20,000円上限）、昇給あり。正看護師または准看護師の免許をお持ちの方。Wワーク歓迎。",
    "datePosted": "2026-10-09",
    "validThrough": "2027-03-31",
    "employmentType": "PART_TIME",
    "applicantLocationRequirements": { "@type": "Country", "name": "JP" },
    hiringOrganization, jobLocation, baseSalary: hourlySalary(1600, 1900)
  },
  {
    "@context": "https://schema.org/",
    "@type": "JobPosting",
    "title": "受付事務",
    "description": "勾当台夕方内科クリニックで受付事務を募集しています。診療時間帯の受付・会計・レセプト業務などを担当していただきます。勤務時間は平日17:00〜21:00、土日14:00〜21:00、週1〜4回。時給1,300円、交通費支給（月額20,000円上限）、昇給あり。18歳以上。医療事務経験者・医療事務の専門学校卒業者・学生歓迎。",
    "datePosted": "2026-09-26",
    "validThrough": "2027-03-31",
    "employmentType": "PART_TIME",
    "applicantLocationRequirements": { "@type": "Country", "name": "JP" },
    hiringOrganization, jobLocation, baseSalary: hourlySalary(1300)
  },
  {
    "@context": "https://schema.org/",
    "@type": "JobPosting",
    "title": "総務事務",
    "description": "勾当台夕方内科クリニックで総務事務を募集しています。厚生局・保健所・各業者との連絡調整や書類作成など、クリニック運営に関わる事務作業を担当していただきます。時給1,300円、交通費支給（月額20,000円上限）、昇給あり。18歳以上。",
    "datePosted": "2026-09-26",
    "validThrough": "2027-03-31",
    "employmentType": "PART_TIME",
    "applicantLocationRequirements": { "@type": "Country", "name": "JP" },
    hiringOrganization, jobLocation, baseSalary: hourlySalary(1300)
  }
];

// 採用ページの求人カード。時給は職種ごとに複数行（正看護師・准看護師など）持てる
const jobs = [
  {
    title: "看護師",
    accent: "coral",
    icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 9v6"/><path d="M9 12h6"/>',
    summary: "採血・点滴・注射・予防接種・検査など、外来診療の補助を担当していただきます。",
    wages: [{ role: "正看護師", yen: "1,900" }, { role: "准看護師", yen: "1,600" }],
    hours: ["平日 17:00〜21:00", "土日 14:00〜21:00"],
    days: "週1回〜（応相談）",
    qualification: "正看護師・准看護師"
  },
  {
    title: "受付事務",
    accent: "turquoise",
    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    summary: "診療時間帯の受付・会計・レセプト業務などを担当していただきます。",
    wages: [{ role: "", yen: "1,300" }],
    hours: ["平日 17:00〜21:00", "土日 14:00〜21:00"],
    days: "週1〜4回"
  },
  {
    title: "総務事務",
    accent: "turquoise",
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>',
    summary: "厚生局・保健所・各業者との連絡調整や書類作成など、クリニック運営に関わる事務作業を担当していただきます。",
    wages: [{ role: "", yen: "1,300" }],
    hours: ["診療時間外（応相談）"],
    days: "週2日以上（応相談）"
  }
];
---

{jobPostings.map((job) => (
  <script type="application/ld+json" set:html={JSON.stringify(job)} />
))}

<Layout
  title="採用情報 | 勾当台夕方内科クリニック"
  description="勾当台夕方内科クリニックの採用情報。看護師（時給1,600〜1,900円）、受付事務・総務事務（時給1,300円）を募集中。勾当台公園駅徒歩2分。"
  hideLineButton
>
  <Header />
  <main class="page-main">
    <section class="recruit-hero">
      <RecruitVisual titleTag="h1" showAccess>
        <a href="#apply" class="hero-apply-btn">応募フォームへ</a>
      </RecruitVisual>
    </section>

    <section class="section recruit-detail">
      <div class="container">
        <p class="recruit-lead">
          勾当台夕方内科クリニックでは、一緒に働く看護師と事務スタッフを募集しています。<br />
          ご応募をお待ちしております。
        </p>

        <div class="recruit-grid">
          <div class="recruit-info">
            <div class="job-cards">
              {jobs.map((job) => (
                <article class={`job-card job-card--${job.accent}`}>
                  <div class="job-card-head">
                    <span class="job-card-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={job.icon} />
                    </span>
                    <h2>{job.title}</h2>
                  </div>
                  <p class="job-card-summary">{job.summary}</p>
                  <dl class="job-card-specs">
                    <div>
                      <dt>時給</dt>
                      <dd>
                        {job.wages.map((w) => (
                          <span class="job-wage">
                            {w.role && <span class="job-wage-role">{w.role}</span>}
                            <strong>{w.yen}</strong>円
                          </span>
                        ))}
                      </dd>
                    </div>
                    <div>
                      <dt>勤務時間</dt>
                      <dd>{job.hours.map((h) => <span class="job-line">{h}</span>)}</dd>
                    </div>
                    <div>
                      <dt>勤務日数</dt>
                      <dd>{job.days}</dd>
                    </div>
                    {job.qualification && (
                      <div>
                        <dt>応募資格</dt>
                        <dd>{job.qualification}</dd>
                      </div>
                    )}
                  </dl>
                </article>
              ))}
            </div>

            <p class="both-note">※ 受付事務と総務事務は、両方の業務を組み合わせて働くことも可能です。</p>

            <div class="common-conditions">
              <div class="common-conditions-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
              </div>
              <h3>共通条件</h3>
              <ul class="condition-list">
                <li><span class="condition-label">試用期間</span><span class="condition-value">3ヶ月</span></li>
                <li><span class="condition-label">交通費</span><span class="condition-value">実費支給（月額20,000円上限）</span></li>
                <li><span class="condition-label">昇給</span><span class="condition-value">あり</span></li>
                <li><span class="condition-label">賞与</span><span class="condition-value">なし</span></li>
                <li><span class="condition-label">応募条件</span><span class="condition-value">18歳以上</span></li>
                <li><span class="condition-label">勤務地</span><span class="condition-value">宮城県仙台市青葉区国分町3丁目8-1 勾当台ビル4階</span></li>
              </ul>
            </div>

            <div class="appeal-points">
              <div class="appeal-points-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <h3>こんな方を歓迎します</h3>
              <ul>
                <li>外来・病棟などで看護師として働いた経験のある方</li>
                <li>医療事務の実務経験がある方</li>
                <li>医療事務の専門学校・スクールを卒業された方</li>
                <li>医療事務を学んでいる学生の方</li>
                <li>夕方〜夜の時間帯に働きたい方</li>
                <li>Wワークをお考えの方</li>
                <li>事務作業やPC操作が得意な方</li>
              </ul>
            </div>
          </div>

          <div id="apply" class="recruit-form-wrapper">
            <h3>応募フォーム</h3>
            <form id="recruitForm" class="recruit-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="a8b6268c-0cb5-40d9-9fb6-e0b3f47da295" />
              <input type="hidden" name="subject" value="【求人応募】勾当台夕方内科クリニック" />
              <input type="hidden" name="from_name" value="勾当台夕方内科クリニック 求人フォーム" />
              <input type="hidden" name="redirect" value="https://koutoudai-yugata-naika.clinic/thanks" />

              <div class="form-group">
                <label for="name">お名前 <span class="required">*</span></label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="email">メールアドレス <span class="required">*</span></label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="form-group">
                <label for="phone">電話番号 <span class="required">*</span></label>
                <input type="tel" id="phone" name="phone" required />
              </div>

              <div class="form-group">
                <label for="position">希望職種 <span class="required">*</span></label>
                <select id="position" name="position" required>
                  <option value="">選択してください</option>
                  <option value="正看護師">正看護師</option>
                  <option value="准看護師">准看護師</option>
                  <option value="受付事務">受付事務</option>
                  <option value="総務事務">総務事務</option>
                  <option value="受付事務・総務事務どちらも">受付事務・総務事務どちらも</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message">自己PR・ご質問など</label>
                <textarea id="message" name="message" rows="5"></textarea>
              </div>

              <button type="submit" class="submit-btn">応募する</button>
              <p class="form-note">※ 郵送等でお送りいただいた応募書類は、理由の如何を問わず返却いたしかねますので、あらかじめご了承ください。</p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <Access hideExtra />

    <div class="container">
      <div class="detail-back">
        <a href="/" class="back-button">ホームに戻る</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  /* ── Recruit Hero ── */
  .recruit-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-coral-bg);
    border-bottom: 1px solid var(--color-coral);
    /* 上はヘッダー（60px固定）の分を足して、見た目の上下余白をそろえる */
    padding: calc(60px + 64px) 24px 64px;
    text-align: center;
    font-family: inherit;
  }

  @media (max-width: 768px) {
    .recruit-hero {
      padding: calc(60px + 56px) 16px 56px;
    }
  }

  .hero-apply-btn {
    display: inline-block;
    margin-top: 22px;
    padding: 11px 34px;
    background: var(--color-coral);
    color: white;
    font-family: "M PLUS Rounded Hero", "M PLUS 1p", sans-serif;
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    border-radius: 9999px;
    box-shadow: 0 5px 0 rgba(30, 58, 95, 0.14);
    transition: opacity 0.2s;
  }

  .hero-apply-btn:hover {
    opacity: 0.85;
  }

  /* ── Recruit Detail ── */
  .recruit-detail {
    background: white;
  }

  .recruit-lead {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 40px;
    text-align: center;
  }

  .recruit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .recruit-info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .job-cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .job-card {
    --accent: var(--color-turquoise);
    --accent-ink: var(--color-turquoise-dark);
    --accent-bg: var(--color-turquoise-bg);
    padding: 24px;
    background: white;
    border: 1px solid var(--accent);
    border-radius: 16px;
  }

  .job-card--coral {
    --accent: var(--color-coral);
    --accent-ink: var(--color-orange-dark);
    --accent-bg: var(--color-coral-bg);
  }

  .job-card-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .job-card-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--accent-bg);
    color: var(--accent);
    display: grid;
    place-items: center;
  }

  .job-card-head h2 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-navy);
    letter-spacing: 0.05em;
  }

  .job-card-summary {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: 18px;
  }

  .job-card-specs {
    padding: 2px 16px;
    background: var(--accent-bg);
    border-radius: 12px;
  }

  .job-card-specs > div {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    gap: 18px;
    padding: 13px 0;
  }

  .job-card-specs > div + div {
    border-top: 1px solid rgba(30, 58, 95, 0.08);
  }

  .job-card-specs dt {
    min-width: 4.4em;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-ink);
  }

  .job-card-specs dd {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-navy);
    line-height: 1.7;
  }

  .job-line,
  .job-wage {
    display: block;
    white-space: nowrap;
  }

  .job-wage-role {
    display: inline-block;
    min-width: 5.2em;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .job-wage strong {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin-right: 2px;
  }

  .both-note {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    text-align: center;
    padding: 16px 0;
  }

  .common-conditions {
    padding: 28px;
    background: white;
    border: 1px solid var(--color-coral);
    border-radius: 16px;
    text-align: center;
  }

  .common-conditions-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 16px;
    background: white;
    border: 1px solid var(--color-coral);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-coral);
  }

  .common-conditions h3 {
    font-size: 1.05rem;
    color: var(--color-navy);
    margin-bottom: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .condition-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-align: left;
  }

  .condition-list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .condition-list li:last-child {
    border-bottom: none;
  }

  .condition-label {
    flex-shrink: 0;
    width: 75px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-coral);
  }

  .condition-value {
    flex: 1;
    font-size: 0.9rem;
  }

  .job-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .job-details li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .job-details .label {
    flex-shrink: 0;
    width: 70px;
    font-size: 0.9rem;
    color: #666;
  }

  .job-details .value {
    flex: 1;
  }

  .appeal-points {
    padding: 28px;
    background: white;
    border: 1px solid var(--color-turquoise);
    border-radius: 16px;
    text-align: center;
  }

  .appeal-points-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 16px;
    background: white;
    border: 1px solid var(--color-turquoise);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-turquoise);
  }

  .appeal-points h3 {
    font-size: 1.05rem;
    color: var(--color-navy);
    margin-bottom: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .appeal-points ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .appeal-points li {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    padding-left: 24px;
    position: relative;
  }

  .appeal-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-turquoise);
  }

  .recruit-form-wrapper {
    background: var(--color-coral-bg);
    border: 1px solid var(--color-coral);
    padding: 24px;
    border-radius: 16px;
    position: sticky;
    top: 80px;
    /* 「応募フォームへ」で飛んだとき固定ヘッダー（60px）に隠れないように */
    scroll-margin-top: 80px;
  }

  .recruit-form-wrapper h3 {
    font-size: 1rem;
    color: var(--color-navy);
    margin-bottom: 24px;
    text-align: center;
    font-weight: 600;
  }

  .recruit-form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .required {
    color: #c0392b;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--color-coral);
    border-radius: 12px;
    font-size: 0.95rem;
    font-family: inherit;
    background: white;
    transition: box-shadow 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus,
