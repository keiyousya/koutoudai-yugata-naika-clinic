# 広告APIの認証情報（.env にコピーして埋める。.env はコミットしない）
# 取得手順は README.md を参照

# ─────────────────────────────────────
# Google 広告（gads コマンド）
# ─────────────────────────────────────

# Google Ads API の開発者トークン（API Center で発行）
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth2 クライアント（Google Cloud Console > 認証情報）
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 上記クライアントで生成したリフレッシュトークン
GOOGLE_ADS_REFRESH_TOKEN=

# MCC（管理者）アカウントから操作する場合のログインアカウントID（ハイフンなし10桁）
# 単一アカウント運用なら操作対象と同じIDでよい
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# 操作対象のアカウントID（ハイフンなし10桁）。--customer-id 未指定時の既定値
GOOGLE_ADS_CUSTOMER_ID=

# google-ads ライブラリ必須。proto-plus メッセージを使う（True 固定でよい）
GOOGLE_ADS_USE_PROTO_PLUS=True

# ─────────────────────────────────────
# LINEヤフー広告（lyads コマンド）
# ─────────────────────────────────────

# 広告管理ツール（https://ads.yahoo.co.jp/）でアプリケーション登録して発行する
# ※API利用申請が承認されてから登録できる
LYADS_CLIENT_ID=
LYADS_CLIENT_SECRET=

# scripts/lyads_refresh_token.py で発行したリフレッシュトークン
LYADS_REFRESH_TOKEN=

# 操作対象アカウントID。検索広告とディスプレイ広告で別IDなので両方持つ
# --account-id 未指定時の既定値になる。IDはアカウント開設完了メールに記載
LYADS_SEARCH_ACCOUNT_ID=
LYADS_DISPLAY_ACCOUNT_ID=

# ルートMCCのアカウントID。全APIコールでヘッダー x-z-base-account-id として必須
LYADS_BASE_ACCOUNT_ID=

# テストアカウント（本番環境上だが配信も審査もされない）。--test で使う
# IDはAPI登録完了メールに記載
LYADS_TEST_SEARCH_ACCOUNT_ID=
LYADS_TEST_DISPLAY_ACCOUNT_ID=

# ─────────────────────────────────────
# 共通
# ─────────────────────────────────────

# procyon の広告分析エンドポイント用APIキー（procyon管理画面 > APIキー設定 で発行）
# 実予約数と広告費の突合に使う。未設定でも各コマンド自体は動く
PROCYON_API_KEY=
