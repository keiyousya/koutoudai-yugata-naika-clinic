---
// Procyon Public API スキーマ: https://github.com/keiyousya/helix/blob/main/procyon/openapi-public.yaml
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import Footer from "../components/Footer.astro";
import InfoCard from "../components/InfoCard.astro";
---

<Layout
  title="当院の患者層（年代別割合） | 勾当台夕方内科クリニック"
  description="直近90日間に受診された患者さまの年代別割合をご紹介します。仙台で夜21時まで診療、勾当台公園駅徒歩2分。"
>
  <Header />
  <main class="page-main">
    <SubPageHeader label="Patient Demographics" title="当院の患者層（年代別割合）" />

    <section class="section demographics">
      <div class="container">
        <div class="demographics-header" id="demographicsHeader">
          <div class="period-display" id="periodDisplay">
            <div class="period-label">集計期間</div>
            <div class="period-value">
              <span class="skeleton period-value-skeleton" aria-hidden="true"></span>
            </div>
          </div>
          <div class="last-updated">
            <span id="lastUpdated">--:--</span> 時点
          </div>
        </div>

        <div class="status-message status-message--skeleton" id="statusMessage" role="status">
          <span class="sr-only">患者層データを読み込んでいます</span>
          <div class="chart chart-skeleton" aria-hidden="true">
            {Array.from({ length: 7 }).map(() => (
              <div class="bar-row">
                <span class="skeleton bar-label-skeleton"></span>
                <span class="skeleton bar-track-skeleton"></span>
                <span class="skeleton bar-value-skeleton"></span>
              </div>
            ))}
          </div>
        </div>

        <div class="chart-container" id="chartContainer" style="display: none;">
          <div class="chart" id="ageGroupChart"></div>
        </div>

        <div class="demographics-notes" id="demographicsNotes">
          <p>※ 直近90日間に会計が完了した患者さまを対象に集計しています。</p>
          <p>※ 各年代の割合（%）を表示しています。</p>
        </div>

        <div class="demographics-card-wrapper">
          <InfoCard title="年代を問わず、お気軽にご相談ください">
            <p>
              現在は20〜40代の方を中心にご利用いただいていますが、高血圧・糖尿病・脂質異常症など、年代が上がるにつれて有病率の高まる慢性疾患の管理も当院が力を入れる分野です。<br />
              夕方〜夜間に通いやすい環境を整えていますので、ぜひお気軽にご相談ください。
            </p>
          </InfoCard>
        </div>

        <div class="demographics-card-wrapper">
          <InfoCard title="対象年齢について" variant="coral">
            <p>
              当院は内科のクリニックのため、<strong>原則として15歳以上</strong>の方を診療の対象としております。14歳以下の方は、小児科を標榜する医療機関へのご受診をご検討ください。<br />
              なお、インフルエンザ予防接種は13歳以上の方から承っております。
            </p>
          </InfoCard>
        </div>
      </div>
    </section>

    <section class="back-section">
      <div class="container">
        <div class="detail-back">
          <a href="/" class="back-button">ホームに戻る</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style is:global>
  .page-main {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 72px);
  }

  .demographics {
    background: white;
    flex: 1;
  }

  .demographics-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    padding: 24px;
    background: var(--color-turquoise-bg);
    border: 1px solid var(--color-turquoise);
    border-radius: 16px;
  }

  .period-display {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .period-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .period-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .last-updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .status-message {
    text-align: center;
    padding: 48px 24px;
    margin-bottom: 32px;
  }

  /* 初期表示のスケルトンは .chart-container と同じ余白で置く */
  .status-message--skeleton {
    padding: 0;
    margin-bottom: 40px;
  }

  .chart-skeleton {
    max-width: 720px;
    margin: 0 auto;
  }

  .chart-skeleton .bar-label-skeleton {
    width: 70%;
    height: 0.9rem;
    border-radius: 4px;
    justify-self: end;
  }

  .chart-skeleton .bar-track-skeleton {
    height: 24px;
    border-radius: 6px;
  }

  .chart-skeleton .bar-value-skeleton {
    width: 80%;
    height: 0.9rem;
    border-radius: 4px;
    justify-self: end;
  }

  .period-value .period-value-skeleton {
    display: inline-block;
    vertical-align: middle;
    width: 12em;
    height: 1em;
    border-radius: 4px;
  }

  .loading {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  /* 読み込み失敗時。予約状況ページと同じく、グレーの枠で控えめに出す */
  .error {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    max-width: 720px;
    margin: 0 auto;
    padding: 28px 20px;
    background: #f9f9f9;
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .error-icon {
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }

  .error-title {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .error-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .chart-container {
    max-width: 720px;
    margin: 0 auto 40px;
  }

  .chart {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 80px 1fr 56px;
    align-items: center;
    gap: 12px;
  }

  .bar-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-navy);
    text-align: right;
  }

  .bar-track {
    position: relative;
    height: 24px;
    background: #f1f3f5;
    border-radius: 6px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: var(--color-turquoise);
    border-radius: 6px;
    width: 0;
    transition: width 0.6s ease;
  }

  .bar-value {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    text-align: right;
  }

  .demographics-card-wrapper {
    max-width: 720px;
    margin: 0 auto 32px;
  }

  .demographics-notes {
    text-align: center;
    margin-bottom: 32px;
  }

  .demographics-notes p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 4px;
  }

  .back-section {
    background: white;
    padding: 0 0 80px;
  }

  .detail-back {
    text-align: center;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    padding: 12px 32px;
    background: white;
    border: 1px solid var(--color-navy);
    border-radius: 24px;
    color: var(--color-navy);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }

  .back-button:hover {
    background: var(--color-navy);
    color: white;
  }

  @media (max-width: 768px) {
    .demographics-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .period-value {
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .bar-row {
      grid-template-columns: 64px 1fr 48px;
      gap: 8px;
    }

    .bar-label,
    .bar-value {
      font-size: 0.8rem;
    }

  }
</style>

<script>
  const PROCYON_BASE = import.meta.env.PUBLIC_PROCYON_BASE_URL || 'https://api.procyon.helix.keiyousya.com';
  const PROCYON_TENANT = import.meta.env.PUBLIC_PROCYON_TENANT || 'koutoudai-yugata-naika';
  const API_URL = `${PROCYON_BASE}/${PROCYON_TENANT}/v1/patient-demographics`;
  const UPDATE_INTERVAL = 60 * 60 * 1000; // 1 hour

  interface AgeGroupRatio {
    ageGroup: string;
    label: string;
    percentage: number;
  }

  interface ApiResponse {
    periodStart: string;
    periodEnd: string;
    ageGroups: AgeGroupRatio[];
  }

  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    const year = date.getFullYear();
    const month = date.getMonth() + 1;
    const day = date.getDate();
    return `${year}年${month}月${day}日`;
  }

  function updateLastUpdated(): void {
    const now = new Date();
    const hours = String(now.getHours()).padStart(2, '0');
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const seconds = String(now.getSeconds()).padStart(2, '0');
    const element = document.getElementById('lastUpdated');
    if (element) {
      element.textContent = `${hours}:${minutes}:${seconds}`;
    }
  }

  function renderChart(ageGroups: AgeGroupRatio[]): void {
    const chart = document.getElementById('ageGroupChart');
    if (!chart) return;

    chart.innerHTML = '';

    // バーの長さを見やすくするため、最大割合を基準にスケーリング
    const maxPercentage = Math.max(...ageGroups.map(g => g.percentage), 1);

    ageGroups.forEach(group => {
      const row = document.createElement('div');
      row.className = 'bar-row';

      const label = document.createElement('div');
      label.className = 'bar-label';
      label.textContent = group.label;

      const track = document.createElement('div');
      track.className = 'bar-track';

      const fill = document.createElement('div');
      fill.className = 'bar-fill';
      track.appendChild(fill);

      const value = document.createElement('div');
      value.className = 'bar-value';
      value.textContent = `${group.percentage.toFixed(1)}%`;

      row.appendChild(label);
      row.appendChild(track);
      row.appendChild(value);
      chart.appendChild(row);

      // 次フレームで幅を設定してアニメーションを発火
      requestAnimationFrame(() => {
        fill.style.width = `${(group.percentage / maxPercentage) * 100}%`;
      });
    });
  }

  const ERROR_ICON = '<svg class="error-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';

  function showMessage(message: string, type: 'loading' | 'error', note?: string): void {
    const statusMessage = document.getElementById('statusMessage');
    const chartContainer = document.getElementById('chartContainer');
    const notes = document.getElementById('demographicsNotes');
    const header = document.getElementById('demographicsHeader');

    if (!statusMessage || !chartContainer) return;

    statusMessage.style.display = 'block';
    statusMessage.classList.remove('status-message--skeleton');
    statusMessage.innerHTML = type === 'error'
      ? `<div class="error" role="status">${ERROR_ICON}<span class="error-title">${message}</span>${note ? `<span class="error-note">${note}</span>` : ''}</div>`
      : `<div class="${type}">${message}</div>`;
    chartContainer.style.display = 'none';

    // 読み込み失敗時は、集計期間のスケルトンや「--:--」の見出しと注記も出さない
    if (type === 'error') {
      if (notes) notes.style.display = 'none';
      if (header) header.style.display = 'none';
    }
  }

  function hideMessage(): void {
    const statusMessage = document.getElementById('statusMessage');
    const chartContainer = document.getElementById('chartContainer');
    const notes = document.getElementById('demographicsNotes');

    const header = document.getElementById('demographicsHeader');

    if (!statusMessage || !chartContainer) return;

    statusMessage.style.display = 'none';
    chartContainer.style.display = 'block';
    if (notes) notes.style.display = '';
    if (header) header.style.display = '';
  }

  async function fetchDemographics(): Promise<void> {
    try {
      const response = await fetch(API_URL);

      if (!response.ok) {
        throw new Error('患者層データの取得に失敗しました');
      }

      const data: ApiResponse = await response.json();

      // 集計期間の表示
      const periodDisplay = document.getElementById('periodDisplay');
      if (periodDisplay) {
        const periodValue = periodDisplay.querySelector('.period-value');
        if (periodValue) {
          periodValue.textContent = `${formatDate(data.periodStart)} 〜 ${formatDate(data.periodEnd)}`;
        }
      }

      if (!data.ageGroups || data.ageGroups.length === 0) {
        throw new Error('患者層データが見つかりませんでした');
      }

      renderChart(data.ageGroups);
      hideMessage();
      updateLastUpdated();

    } catch (error) {
      console.error('Error fetching patient demographics:', error);
      showMessage(
        '患者層データを読み込めませんでした',
        'error',
        '時間をおいて再度お試しください'
      );
    }
  }

  // Initial fetch
  fetchDemographics();

  // Auto-refresh every hour
  setInterval(fetchDemographics, UPDATE_INTERVAL);
</script>
