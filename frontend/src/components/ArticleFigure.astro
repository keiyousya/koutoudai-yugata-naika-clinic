---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// 本文の段落の間に置く1枚のイラスト（いらすとや等）。caption は任意
type Props = { image: ImageMetadata; alt: string; caption?: string; width?: number };

const { image, alt, caption, width = 200 } = Astro.props;
---

<figure class="article-figure">
  <Image src={image} alt={alt} width={width} loading="lazy" />
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .article-figure {
    margin: 24px auto 28px;
    text-align: center;
  }

  .article-figure :global(img) {
    display: block;
    width: auto;
    max-width: min(100%, 200px);
    height: auto;
    margin: 0 auto;
  }

  .article-figure figcaption {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
