<section id="hours" class="section hours">
  <div class="container">
    <h2 class="section-title">診療時間</h2>
    <div class="hours-layout">
      <!-- 左側：カレンダー（APIから動的取得） -->
      <div class="calendar-side">
        <div class="month-tabs" id="monthTabs">
          <span class="month-tab-indicator" aria-hidden="true"></span>
          <button class="month-tab active" type="button" data-month="0">--月</button>
          <button class="month-tab" type="button" data-month="1">--月</button>
        </div>

        <div class="calendar-container">
          <button class="calendar-nav prev" id="prevMonth" aria-label="前の月">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>

          <div class="calendar-slider">
            <div class="calendar-track" id="calendarTrack">
              <!-- スケルトン（JS描画後に置き換え） -->
              <div class="monthly-calendar">
                <div class="monthly-header"><span>&nbsp;</span></div>
                <div class="monthly-weekdays">
                  <div class="weekday sunday">日</div><div class="weekday">月</div><div class="weekday">火</div><div class="weekday">水</div><div class="weekday">木</div><div class="weekday">金</div><div class="weekday saturday">土</div>
                </div>
                <div class="monthly-grid">
                  {Array.from({ length: 35 }).map(() => (
                    <div class="monthly-cell">
                      <span class="cal-skeleton cal-skeleton--date"></span>
                      <span class="cal-skeleton cal-skeleton--status"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <button class="calendar-nav next" id="nextMonth" aria-label="次の月">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>

        <div class="calendar-legend">
          <div class="legend-item">
            <span class="legend-icon open">○</span>
            <span>診療</span>
          </div>
          <div class="legend-item">
            <span class="legend-icon closed">休</span>
            <span>休診</span>
          </div>
          <div class="legend-item">
            <span class="legend-icon temporary">休</span>
            <span>臨時休診</span>
          </div>
        </div>

        <div class="reception-notes reception-notes--calendar">
          <p class="reception-note">当院は小さなクリニックで、待合の席数に限りがあります。<strong>付き添いの方のご来院はご遠慮ください</strong></p>
        </div>
      </div>

      <!-- 右側：診療時間 -->
      <div class="info-side">
        <!-- 診療時間 -->
        <div class="hours-main" id="hoursJuly">
          <div class="hours-block">
            <span class="hours-block-label">平日（月・水〜金）</span>
            <div class="hours-primary">17:00 - 21:00</div>
            <div class="hours-sub hours-sub--fever">発熱外来 <strong>19:00-21:00</strong></div>
          </div>
          <div class="hours-block">
            <span class="hours-block-label">土日</span>
            <div class="hours-primary">14:00 - 21:00</div>
            <div class="hours-sub hours-sub--fever">発熱外来 <strong>17:00-21:00</strong></div>
          </div>
        </div>

        <div class="hours-facts">
          <div class="hours-fact">
            <span class="hours-fact-label">ご予約</span>
            <span class="hours-fact-value">予約制</span>
            <span class="hours-fact-sub">ご予約はLINEからお願いします</span>
          </div>
          <div class="hours-fact">
            <span class="hours-fact-label">休診日</span>
            <span class="hours-fact-value">火曜・祝日</span>
            <span class="hours-fact-sub">臨時休診はカレンダー参照</span>
          </div>
        </div>

        <div class="hours-last-reception">
          <span class="last-reception-text">受付開始 <strong>平日 17:00</strong> / <strong>土日 14:00</strong></span>
          <span class="last-reception-text">最終受付 <strong>20:50</strong><br class="sp-only" />（LINE予約の当日最終）</span>
        </div>

        <div class="reception-notes">
          <p class="reception-note">受付開始前は、院内でお待ちいただけません。平日17時・土日14時より前のご来院はお控えいただきますようお願いいたします</p>
        </div>
      </div>
    </div>
  </div>
</section>

