---
import RecruitVisual from "./RecruitVisual.astro";
---

<section id="recruit" class="section recruit">
  <div class="container">
    <h2 class="section-title">スタッフ募集</h2>
    <div class="recruit-banner">
      <RecruitVisual titleTag="h3" compact>
        <p class="banner-sub">総務事務も募集中（診療時間外・応相談）</p>
        <a href="/recruit" class="banner-btn">詳細・応募はこちら</a>
      </RecruitVisual>
    </div>
  </div>
</section>

<style>
  .recruit {
    background: white;
  }

  /* 飾りの円は RecruitVisual 側で absolute 配置するので、ここで切り取る */
  .recruit-banner {
    position: relative;
    overflow: hidden;
    max-width: 560px;
    margin: 0 auto;
    background: var(--color-coral-bg);
    border: 1px solid var(--color-coral);
    border-radius: 16px;
    padding: 40px 24px;
    text-align: center;
  }

  .banner-sub {
    margin-top: 10px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .banner-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 14px 36px;
    background: var(--color-coral);
    color: white;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 24px;
    transition: opacity 0.2s;
  }

  .banner-btn:hover {
    opacity: 0.85;
  }

  @media (max-width: 768px) {
    .recruit-banner {
      padding: 32px 12px;
    }
  }
</style>
