---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import LineCta from "../components/LineCta.astro";
import Footer from "../components/Footer.astro";

const pageUrl = "https://koutoudai-yugata-naika.clinic/flu-vaccine";

// インフルエンザ予防接種ページ専用の構造化データ
const pageStructuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "インフルエンザ予防接種｜仙台市青葉区｜勾当台夕方内科クリニック",
  "description": "仙台市青葉区でインフルエンザ予防接種を行っています。13歳以上の方は1回3,300円、仙台市の高齢者定期接種の対象となる65歳以上の方は自己負担1,500円。平日は夜21時まで、土日も接種できます。予約なしでもご来院いただけます（ご予約の方優先）。",
  "keywords": "インフルエンザワクチン 仙台, インフルエンザ 予防接種 仙台, インフルエンザワクチン 仙台市青葉区, インフルエンザワクチン 料金, インフルエンザ 予防接種 夜間, インフルエンザ 予防接種 土日, インフルエンザワクチン 予約なし, インフルエンザワクチン 勾当台, 高齢者インフルエンザ 仙台市, インフルエンザ 予防接種 助成 仙台市, 高齢者インフルエンザ 定期接種 仙台市",
  "url": pageUrl,
  "inLanguage": "ja",
  "about": {
    "@type": "MedicalCondition",
    "name": "インフルエンザ",
    "alternateName": "Influenza"
  },
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient"
  },
  "specialty": {
    "@type": "MedicalSpecialty",
    "name": "感染症"
  }
};

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": "インフルエンザ予防接種",
  "alternateName": ["インフルエンザワクチン接種", "インフルエンザワクチン"],
  "description": "13歳以上の方を対象に、インフルエンザHAワクチンを原則1回接種します。",
  "howPerformed": "問診・診察の上、インフルエンザHAワクチン0.5mLを皮下注射",
  "availableService": {
    "@type": "Offer",
    "price": "3300",
    "priceCurrency": "JPY",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "3300",
      "priceCurrency": "JPY",
      "unitText": "1回"
    }
  },
  "provider": {
    "@type": "MedicalClinic",
    "name": "勾当台夕方内科クリニック",
    "url": "https://koutoudai-yugata-naika.clinic",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "仙台市青葉区",
      "addressRegion": "宮城県",
      "streetAddress": "国分町3丁目8-1 勾当台ビル4階"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Wednesday", "Thursday", "Friday"],
        "opens": "17:00",
        "closes": "21:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday", "Sunday"],
        "opens": "14:00",
        "closes": "21:00"
      }
    ]
  }
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "勾当台夕方内科クリニック",
      "item": "https://koutoudai-yugata-naika.clinic/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "インフルエンザ予防接種",
      "item": pageUrl
    }
  ]
};
---

<Layout
  title="インフルエンザ予防接種 3,300円・高齢者定期接種1,500円｜仙台市青葉区 夜21時・土日も接種｜勾当台夕方内科クリニック"
  description="仙台市青葉区でインフルエンザ予防接種（ワクチン）を行っています。13歳以上の方は1回3,300円、仙台市の高齢者定期接種の対象となる65歳以上の方は自己負担1,500円。平日は夜21時まで、土日も接種可能。予約なしでもご来院いただけます（ご予約の方優先）。勾当台公園駅徒歩2分。"
>
  <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  <Header />
  <main class="page-main">
    <SubPageHeader label="Influenza Vaccination" title="インフルエンザ予防接種" variant="coral" />

    <section class="page-intro">
      <div class="container">
        <p class="intro-text">
          <strong>2026年（令和8年）9月16日（水）</strong>より、<br class="pc-only" />
          インフルエンザ予防接種を行います。<br class="pc-only" />
          平日は<strong>夜21時まで</strong>、<strong>土日も</strong>接種できます。<br />
          <strong>65歳以上の方</strong>は、仙台市の定期接種（自己負担<strong>1,500円</strong>）として接種いただけます。
        </p>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">インフルエンザ予防接種の料金</h2>
        <div class="price-cards">
          <div class="price-card">
            <div class="price-card-header">
              <span class="price-card-badge">13歳〜64歳の方</span>
              <h3 class="price-card-title">任意接種</h3>
              <p class="price-card-lead">ご希望の方が自費で受ける接種</p>
            </div>
            <p class="price-card-price"><span class="price-number">3,300</span>円<span class="price-tax">（税込）</span><span class="price-unit">／1回</span></p>
            <p class="price-card-note">※ 保険適用外のため、自費診療となります</p>
            <p class="price-card-note">※ 12歳以下のお子さまの接種は行っておりません</p>
            <p class="price-card-note">※ 65歳以上でも、仙台市に住民票がない方などはこちらになります</p>
            <a href="#nini" class="price-card-link">任意接種の詳しいご案内 →</a>
          </div>
          <div class="price-card price-card-teiki">
            <div class="price-card-header">
              <span class="price-card-badge badge-turquoise">65歳以上の方</span>
              <h3 class="price-card-title">定期接種</h3>
              <p class="price-card-lead">仙台市の費用助成を受けて公費で行う接種</p>
            </div>
            <p class="price-card-price"><span class="price-number">1,500</span>円<span class="price-label">（自己負担）</span><span class="price-unit">／1回</span></p>
            <p class="price-card-note">※ 仙台市に住民票のある対象の方の自己負担額です</p>
            <p class="price-card-note">※ 市民税非課税世帯の方などは無料です（確認書類の提示が必要）</p>
            <p class="price-card-note">※ 60〜64歳でも、心臓・腎臓・呼吸器・免疫機能に障害のある方は対象です</p>
            <a href="#teiki" class="price-card-link">定期接種の詳しいご案内 →</a>
          </div>
        </div>
        <div class="price-cta">
          <LineCta lines={[
            "LINE予約の問診で「インフルエンザ予防接種希望」とご記入ください。",
            "ご予約なしでもご来院いただけます（ご予約の方優先）。"
          ]} />
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">共通のご案内</h2>
        <p class="section-lead">任意接種・定期接種のどちらにも共通する内容です。</p>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>接種開始日</dt>
            <dd>2026年（令和8年）9月16日（水）</dd>
          </div>
          <div class="spec-row">
            <dt>接種回数</dt>
            <dd>原則1回</dd>
          </div>
          <div class="spec-row">
            <dt>使用ワクチン</dt>
            <dd>インフルエンザHAワクチン「KMB」</dd>
          </div>
          <div class="spec-row">
            <dt>接種できる時間</dt>
            <dd><div class="time-grid"><span class="time-day">平日（月・水〜金）</span><span class="time-range">17:00〜21:00</span><span class="time-day">土日</span><span class="time-range">14:00〜21:00</span></div><p class="spec-attention">予防接種は、<strong>原則として一般内科外来の時間帯</strong>（平日17:00〜19:00／土日14:00〜17:00）にお越しください。平日19:00以降・土日17:00以降は発熱外来の時間帯です。</p><span class="spec-note">火曜日は休診です。臨時休診は<a href="/#hours" class="ref-link">診療日カレンダー</a>でご確認ください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>ご予約</dt>
            <dd>原則LINEからご予約をお願いしております<span class="spec-note">ご予約なしでもご来院いただけますが、ご予約の方を優先してご案内するため、お待ちいただくことがあります。その場合も原則として一般内科外来の時間帯にお越しください。</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="page-section bg-coral" id="nini">
      <div class="container">
        <h2 class="page-section-title">任意接種（13歳〜64歳の方）</h2>
        <p class="section-lead">ご希望の方が自費で受ける接種です。</p>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>対象となる方</dt>
            <dd>13歳以上の方<span class="spec-note">中学生の方は、保護者の方と一緒にご来院ください。高校生以上の方は、お一人でも接種いただけます。12歳以下のお子さまの接種は行っておりません。</span></dd>
          </div>
          <div class="spec-row">
            <dt>料金</dt>
            <dd>3,300円（税込・1回）<span class="spec-note">保険適用外のため、自費診療となります。</span></dd>
          </div>
          <div class="spec-row">
            <dt>予診票</dt>
            <dd>当院にご用意しています<span class="spec-note"><a href="/forms/flu-vaccine-yoshinhyo.html" class="ref-link" target="_blank" rel="noopener noreferrer">こちら</a>から印刷してご持参いただくこともできます。</span></dd>
          </div>
          <div class="spec-row">
            <dt>健康被害が<br />生じた場合</dt>
            <dd>医薬品副作用被害救済制度の対象となることがあります<span class="spec-note">任意接種のため、万が一、接種によって入院治療が必要な程度の病気や、日常生活が著しく制限される程度の障害などが生じた場合は、独立行政法人 医薬品医療機器総合機構（PMDA）の<a href="https://www.pmda.go.jp/relief-services/adr-sufferers/0011.html" class="ref-link" target="_blank" rel="noopener noreferrer">医薬品副作用被害救済制度</a>の対象となることがあります。</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="page-section bg-turquoise" id="teiki">
      <div class="container">
        <h2 class="page-section-title">定期接種（65歳以上の方）</h2>
        <p class="section-lead">
          仙台市の費用助成を受けて、公費で行う接種です。<br />
          当院は<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/teki/influenza.html" class="ref-link" target="_blank" rel="noopener noreferrer">仙台市の高齢者インフルエンザ予防接種 登録医療機関</a>です。
        </p>
        <dl class="spec-list spec-list-teiki">
          <div class="spec-row">
            <dt>対象となる方</dt>
            <dd>
              仙台市に住民票のある、次のいずれかに当てはまる方
              <ul class="attention-sublist">
                <li>接種日時点で<strong>65歳以上</strong>の方</li>
                <li>接種日時点で60歳以上65歳未満の方で、心臓・腎臓・呼吸器の機能、またはヒト免疫不全ウイルスによる免疫機能に障害のある方（身体障害者手帳1級相当）</li>
              </ul>
            </dd>
          </div>
          <div class="spec-row">
            <dt>自己負担額</dt>
            <dd>1,500円（1シーズン1回）<span class="spec-note">生活保護世帯の方、市民税非課税世帯の方などは無料です。下の「無料になる方」をご覧ください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>接種期間</dt>
            <dd>令和8年10月1日（木）〜令和9年1月31日（日）<span class="spec-note">今シーズンはインフルエンザの流行入りが早いため、9月15日以降の接種も助成の対象となります。当院でもすでに接種いただけます。</span></dd>
          </div>
          <div class="spec-row">
            <dt>持ち物</dt>
            <dd>マイナンバーカード・健康保険証などの本人確認書類<span class="spec-note">60歳以上65歳未満で障害により対象となる方は、身体障害者手帳もお持ちください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>予診票</dt>
            <dd>当院にご用意しています<span class="spec-note">仙台市の様式を<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/toroku/documents/infuru_yosinhyou.pdf" class="ref-link" target="_blank" rel="noopener noreferrer">仙台市ホームページ</a>から印刷してご持参いただくこともできます。</span></dd>
          </div>
          <div class="spec-row">
            <dt>接種後</dt>
            <dd>予防接種済証をお渡しします<span class="spec-note">接種の記録になりますので、大切に保管してください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>健康被害が<br />生じた場合</dt>
            <dd>予防接種法に基づく救済制度の対象となることがあります<span class="spec-note">定期接種は予防接種法に基づく接種のため、健康被害が接種によるものと厚生労働大臣が認定したときは、医療費・障害年金等の給付を受けられます。詳しくは<a href="https://www.city.sendai.jp/kenkoanzen-kansen/yobosesshu/images/kenkouhigaikyusaiseido.html" class="ref-link" target="_blank" rel="noopener noreferrer">副反応・予防接種健康被害救済制度について（仙台市）</a>をご覧ください。</span></dd>
          </div>
        </dl>

        <h3 class="sub-heading">自己負担金が無料になる方</h3>
        <div class="info-box">
          <p class="info-text">
            次に当てはまる方は、<strong>確認書類を受付でご提示いただくと無料</strong>になります。
          </p>
          <ul class="attention-sublist">
            <li><strong>生活保護世帯の方</strong> … 生活保護費支給票</li>
            <li><strong>市民税非課税世帯の方</strong> … 令和8年度 仙台市の介護保険料決定通知書（「市町村民税非課税世帯」と記載のあるもの）、または確認通知書（「自己負担金免除対象者です」と記載のあるもの）</li>
            <li><strong>中国残留邦人等支援給付制度を受給されている方</strong> … 同制度の本人確認証</li>
          </ul>
          <p class="info-note">
            ※ 確認書類のご提示がない場合は、自己負担額1,500円をお支払いいただきます。後日ご提示いただいた場合も返金はできませんので、ご注意ください。<br />
            ※ 介護保険料決定通知書をお持ちでない方は、仙台市への申請で「確認通知書」が届きます（10日程度かかります）。詳しくは<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/yobosesshu/jikohutankinmenjyo.html" class="ref-link" target="_blank" rel="noopener noreferrer">仙台市ホームページ</a>をご覧ください。
          </p>
        </div>
        <p class="source-note">
          出典：<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/teki/influenza.html" class="ref-link" target="_blank" rel="noopener noreferrer">高齢者インフルエンザの予防接種について（仙台市）</a>
        </p>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">接種の時期の目安</h2>
        <div class="info-box">
          <p class="info-text">
            日本では例年12月〜4月頃にインフルエンザが流行するため、<strong>12月中旬までに接種を終える</strong>ことが望ましいとされています（<a href="https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/kenkou_iryou/kenkou/kekkaku-kansenshou/infulenza/QA2024.html" class="ref-link" target="_blank" rel="noopener noreferrer">厚生労働省 インフルエンザQ&A</a>）。<br />
            流行が本格化する前の、<strong>早めの接種</strong>をおすすめします。
          </p>
          <p class="info-note">
            ※ ワクチンを接種してもインフルエンザにかかることはありますが、発病や重症化を防ぐ効果が期待できます。<br />
            ※ 医師が必要と認めた場合は、<a href="/covid-vaccine" class="ref-link">新型コロナウイルス感染症の予防接種</a>など他のワクチンと同時に接種することもできます。
          </p>
        </div>
      </div>
    </section>

    <section class="page-section bg-coral">
      <div class="container">
        <h2 class="page-section-title">接種を受けられない方・ご相談が必要な方</h2>
        <ul class="attention-list">
          <li class="attention-item">
            <span class="attention-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </span>
            <div>
              <strong>接種を受けられない方</strong>
              <ul class="attention-sublist">
                <li>明らかな発熱がある方</li>
                <li>重い急性の病気にかかっている方</li>
                <li>過去にこのワクチンの成分でアナフィラキシー（強いアレルギー反応）を起こしたことがある方</li>
                <li>その他、医師が接種に適さないと判断した方</li>
              </ul>
            </div>
          </li>
          <li class="attention-item">
            <span class="attention-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </span>
            <div>
              <strong>接種前にご相談ください</strong>
              <ul class="attention-sublist">
                <li>心臓・血管、腎臓、肝臓、血液の病気や、発育障害などの持病がある方</li>
                <li>過去に予防接種後2日以内に発熱した方、または全身の発疹などアレルギーを疑う症状が出たことがある方</li>
                <li>過去にけいれんを起こしたことがある方</li>
                <li>過去に免疫不全と診断されたことがある方、または近親者に先天性免疫不全症の方がいる方</li>
                <li>間質性肺炎や気管支喘息など、呼吸器の病気がある方</li>
                <li>ワクチンの成分、または鶏卵・鶏肉など鶏由来のものにアレルギーがあるおそれのある方</li>
              </ul>
            </div>
          </li>
        </ul>
        <p class="source-note">
