  #hours .hours-sub--fever { font-size: 1rem; font-weight: 600; color: color-mix(in srgb, var(--color-turquoise-dark) 75%, var(--color-navy)); }
  #hours .hours-sub--fever strong { font-size: 1.15rem; font-weight: 700; }

  #hours .hours-block { padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid rgba(62, 184, 200, 0.3); }
  #hours .hours-block:last-child { padding-bottom: 0; margin-bottom: 0; border-bottom: none; }
  #hours .hours-block-label { display: block; font-size: 0.9rem; font-weight: 600; color: var(--color-navy); margin-bottom: 10px; }

  #hours .hours-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px; }
  #hours .hours-fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 16px 12px;
    background: white;
    border: 1px solid var(--color-turquoise);
    border-radius: 12px;
    text-align: center;
  }
  #hours .hours-fact-label { font-size: 0.8rem; font-weight: 600; color: var(--color-text-muted); }
  #hours .hours-fact-value { font-size: 1.25rem; font-weight: 700; color: var(--color-navy); }
  #hours .hours-fact-sub { font-size: 0.8rem; color: var(--color-text-muted); }

  #hours .hours-last-reception { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; margin-bottom: 24px; }
  #hours .last-reception-text { font-size: 1rem; color: var(--color-text-muted); }
  #hours .reception-notes {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 520px;
    margin: 0 auto 24px;
    text-align: center;
  }
  #hours .reception-notes--calendar { margin: 24px auto 0; }
  #hours .reception-note {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    text-wrap: balance;
  }
  #hours .reception-note::before {
    content: "※";
    color: var(--color-coral);
    font-weight: 700;
    margin-right: 0.3em;
  }
  #hours .reception-note strong {
    font-weight: 700;
    color: var(--color-coral);
  }
  #hours .last-reception-text strong { font-weight: 700; color: var(--color-navy); }



  /* 2段レイアウト用 */



  /* カレンダースケルトン */
  #hours .cal-skeleton {
    display: block;
    background: #eee;
    border-radius: 4px;
    animation: cal-skeleton-pulse 1.5s ease-in-out infinite;
  }

  #hours .cal-skeleton--date { width: 1.2em; height: 0.95rem; margin-bottom: 4px; }
  #hours .cal-skeleton--status { width: 1.2em; height: 0.85rem; }

  @keyframes cal-skeleton-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  #hours .sp-only { display: none; }

  @media (max-width: 900px) {
    #hours .hours-layout { grid-template-columns: 1fr; gap: 32px; }
    #hours .calendar-side { max-width: 500px; margin: 0 auto; }
    #hours .info-side { max-width: 500px; margin: 0 auto; }
  }

  @media (max-width: 768px) {
    #hours .sp-only { display: inline; }
    #hours .monthly-cell { padding: 8px 2px; min-height: 50px; }
    #hours .monthly-cell .date { font-size: 0.85rem; }
    #hours .monthly-cell .status { font-size: 0.75rem; }
    #hours .calendar-legend { flex-direction: row; gap: 20px; }
    #hours .calendar-nav.prev { left: -16px; }
    #hours .calendar-nav.next { right: -16px; }
    #hours .calendar-nav { width: 36px; height: 36px; }
    #hours .calendar-nav svg { width: 20px; height: 20px; }
  }
</style>

<script>
  const PROCYON_BASE = import.meta.env.PUBLIC_PROCYON_BASE_URL || 'https://api.procyon.helix.keiyousya.com';
  const PROCYON_TENANT = import.meta.env.PUBLIC_PROCYON_TENANT || 'koutoudai-yugata-naika';

  interface CalendarDate {
    date: string;
    dayOfWeek: number;
    status: 'open' | 'regular_closed' | 'holiday_closed' | 'temporary_closed';
    holidayName?: string;
  }

  interface CalendarMonth {
    month: string;
    dates: CalendarDate[];
  }

  interface CalendarResponse {
    months: CalendarMonth[];
  }

  const WEEKDAY_LABELS = ['日', '月', '火', '水', '木', '金', '土'];

  // 当月・翌月の YYYY-MM を取得
  function getTargetMonths(): string[] {
    const now = new Date();
    const m1 = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    const next = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    const m2 = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}`;
    return [m1, m2];
  }

  function renderMonthCalendar(monthData: CalendarMonth): string {
    const [year, month] = monthData.month.split('-').map(Number);
    const label = `${year}年${month}月`;

    // 月の1日の曜日（日曜始まり）
    const firstDow = new Date(year, month - 1, 1).getDay();

    // 先頭の空セル
    let cells = '';
    for (let i = 0; i < firstDow; i++) {
      cells += '<div class="monthly-cell empty"></div>';
    }

    // 日付セル
    for (const d of monthData.dates) {
      const dayNum = new Date(d.date).getDate();
      const isOpen = d.status === 'open';
      const isHoliday = d.status === 'holiday_closed';
      const isTemporary = d.status === 'temporary_closed';
      const isClosed = !isOpen;

      const cellClasses = [
        'monthly-cell',
        isOpen ? 'open' : 'closed',
        isHoliday ? 'holiday' : '',
        isTemporary ? 'temporary' : '',
      ].filter(Boolean).join(' ');

      const dateClasses = [
        'date',
        d.dayOfWeek === 0 ? 'sunday' : '',
        d.dayOfWeek === 6 ? 'saturday' : '',
      ].filter(Boolean).join(' ');

      cells += `<div class="${cellClasses}">
        <span class="${dateClasses}">${dayNum}</span>
        <span class="status">${isOpen ? '○' : '休'}</span>
      </div>`;
    }

    // 末尾の空セル（7の倍数に合わせる）
    const totalCells = firstDow + monthData.dates.length;
    const remainder = totalCells % 7;
    if (remainder > 0) {
      for (let i = 0; i < 7 - remainder; i++) {
        cells += '<div class="monthly-cell empty"></div>';
      }
    }

    const weekdayHeaders = WEEKDAY_LABELS.map((day, i) => {
      const cls = i === 0 ? 'weekday sunday' : i === 6 ? 'weekday saturday' : 'weekday';
      return `<div class="${cls}">${day}</div>`;
    }).join('');

    return `<div class="monthly-calendar">
      <div class="monthly-header"><span>${label}</span></div>
      <div class="monthly-weekdays">${weekdayHeaders}</div>
      <div class="monthly-grid">${cells}</div>
    </div>`;
  }

  let currentMonth = 0;
  const totalMonths = 2;
  const track = document.getElementById('calendarTrack');
  const prevBtn = document.getElementById('prevMonth') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextMonth') as HTMLButtonElement | null;
  const monthTabsContainer = document.getElementById('monthTabs');

  function updateSlider() {
    if (track) {
      track.style.transform = `translateX(-${currentMonth * 100}%)`;
    }
    if (prevBtn) {
      prevBtn.disabled = currentMonth === 0;
      prevBtn.style.opacity = currentMonth === 0 ? '0.3' : '1';
    }
    if (nextBtn) {
      nextBtn.disabled = currentMonth === totalMonths - 1;
      nextBtn.style.opacity = currentMonth === totalMonths - 1 ? '0.3' : '1';
    }
    monthTabsContainer?.setAttribute('data-active', String(currentMonth));
    monthTabsContainer?.querySelectorAll('.month-tab').forEach((tab, i) => {
      tab.classList.toggle('active', i === currentMonth);
    });
  }

  function bindNavigation() {
    prevBtn?.addEventListener('click', () => {
      if (currentMonth > 0) { currentMonth--; updateSlider(); }
    });
    nextBtn?.addEventListener('click', () => {
      if (currentMonth < totalMonths - 1) { currentMonth++; updateSlider(); }
    });
    monthTabsContainer?.querySelectorAll('.month-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentMonth = parseInt((tab as HTMLElement).dataset.month || '0');
        updateSlider();
      });
    });
  }

  async function loadCalendar() {
    const months = getTargetMonths();

    // タブのラベルを設定
    if (monthTabsContainer) {
      const tabs = monthTabsContainer.querySelectorAll('.month-tab');
      months.forEach((m, i) => {
        const monthNum = parseInt(m.split('-')[1]);
        if (tabs[i]) tabs[i].textContent = `${monthNum}月`;
      });
    }

    try {
      const url = new URL(`${PROCYON_BASE}/${PROCYON_TENANT}/v1/consultation-calendar`);
      months.forEach(m => url.searchParams.append('months', m));

      const res = await fetch(url.toString());
      if (!res.ok) throw new Error('fetch failed');
      const data: CalendarResponse = await res.json();

      if (track) {
        track.innerHTML = data.months.map(renderMonthCalendar).join('');
      }
    } catch {
      if (track) {
        track.innerHTML = `<div class="monthly-calendar">
          <div class="monthly-header"><span>読み込みに失敗しました</span></div>
          <div class="monthly-grid" style="padding: 40px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem;">
            しばらく経ってから再度お試しください
          </div>
        </div>`;
      }
    }

    updateSlider();
  }

  bindNavigation();
  loadCalendar();
</script>

