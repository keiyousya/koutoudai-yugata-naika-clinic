---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SubPageHeader from "../components/SubPageHeader.astro";
import LineCta from "../components/LineCta.astro";
import LineReservationGuide from "../components/LineReservationGuide.astro";
import Footer from "../components/Footer.astro";

const pageUrl = "https://koutoudai-yugata-naika.clinic/zoster-vaccine";

// 帯状疱疹ワクチンページ専用の構造化データ
const pageStructuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": "帯状疱疹ワクチン｜仙台市青葉区｜勾当台夕方内科クリニック",
  "description": "仙台市青葉区で帯状疱疹ワクチン（シングリックス・生ワクチン）の接種を行っています。任意接種はシングリックス1回22,000円、生ワクチン7,700円（税込）。仙台市の定期接種の対象となる方は自己負担でシングリックス1回11,000円、生ワクチン5,000円。平日は夜19時まで、土日も接種できます。",
  "keywords": "帯状疱疹ワクチン 仙台, 帯状疱疹ワクチン 仙台市青葉区, シングリックス 仙台, シングリックス 料金 仙台, 帯状疱疹 生ワクチン 仙台, 帯状疱疹ワクチン 定期接種 仙台市, 帯状疱疹ワクチン 65歳 仙台市, 帯状疱疹ワクチン 夜間, 帯状疱疹ワクチン 土日, 帯状疱疹ワクチン 勾当台",
  "url": pageUrl,
  "inLanguage": "ja",
  "about": {
    "@type": "MedicalCondition",
    "name": "帯状疱疹",
    "alternateName": "Herpes zoster"
  },
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient"
  },
  "specialty": {
    "@type": "MedicalSpecialty",
    "name": "感染症"
  }
};

const provider = {
  "@type": "MedicalClinic",
  "name": "勾当台夕方内科クリニック",
  "url": "https://koutoudai-yugata-naika.clinic",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "仙台市青葉区",
    "addressRegion": "宮城県",
    "streetAddress": "国分町3丁目8-1 勾当台ビル4階"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Wednesday", "Thursday", "Friday"],
      "opens": "17:00",
      "closes": "21:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Saturday", "Sunday"],
      "opens": "14:00",
      "closes": "21:00"
    }
  ]
};

const serviceStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "帯状疱疹ワクチン（シングリックス）",
    "alternateName": ["乾燥組換え帯状疱疹ワクチン", "帯状疱疹 不活化ワクチン"],
    "description": "50歳以上の方などを対象に、組換え帯状疱疹ワクチン「シングリックス」を2か月以上あけて2回接種します。",
    "howPerformed": "問診・診察の上、シングリックス0.5mLを筋肉内注射（2回）",
    "availableService": {
      "@type": "Offer",
      "price": "22000",
      "priceCurrency": "JPY",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "22000",
        "priceCurrency": "JPY",
        "unitText": "1回"
      }
    },
    "provider": provider
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "帯状疱疹ワクチン（生ワクチン）",
    "alternateName": ["乾燥弱毒生水痘ワクチン", "帯状疱疹 生ワクチン"],
    "description": "50歳以上の方を対象に、乾燥弱毒生水痘ワクチン（ビケン）を1回接種します。",
    "howPerformed": "問診・診察の上、乾燥弱毒生水痘ワクチン0.5mLを皮下注射（1回）",
    "availableService": {
      "@type": "Offer",
      "price": "7700",
      "priceCurrency": "JPY",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "7700",
        "priceCurrency": "JPY",
        "unitText": "1回"
      }
    },
    "provider": provider
  }
];

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "勾当台夕方内科クリニック",
      "item": "https://koutoudai-yugata-naika.clinic/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "帯状疱疹ワクチン",
      "item": pageUrl
    }
  ]
};
---

<Layout
  title="帯状疱疹ワクチン シングリックス22,000円・生ワクチン7,700円｜仙台市の定期接種対応｜仙台市青葉区 夜19時・土日も接種｜勾当台夕方内科クリニック"
  description="仙台市青葉区で帯状疱疹ワクチン（シングリックス・生ワクチン）の接種を行っています。任意接種はシングリックス1回22,000円（2回接種）、生ワクチン7,700円（税込）。仙台市の定期接種の対象となる方は、シングリックス1回11,000円、生ワクチン5,000円の自己負担で接種できます。予約制、平日は夜19時まで、土日も接種可能。勾当台公園駅徒歩2分。"
>
  <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  <Header />
  <main class="page-main">
    <SubPageHeader label="Shingles Vaccination" title="帯状疱疹ワクチン" variant="coral" />

    <section class="page-intro">
      <div class="container">
        <p class="intro-text">
          帯状疱疹ワクチン（<strong>シングリックス</strong>・<strong>生ワクチン</strong>）の接種を行っています。平日は<strong>夜19時まで</strong>、<strong>土日も</strong>接種できます。今年度<strong>65・70・75・80歳など</strong>になる方は、仙台市の定期接種として接種いただけます。
        </p>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">帯状疱疹ワクチンの料金</h2>
        <div class="price-cards">
          <div class="price-card">
            <div class="price-card-header">
              <span class="price-card-badge">50歳以上の方など</span>
              <h3 class="price-card-title">任意接種</h3>
              <p class="price-card-lead">ご希望の方が自費で受ける接種</p>
            </div>
            <dl class="price-rows">
              <div class="price-row">
                <dt>シングリックス<span class="price-row-sub">2回接種</span></dt>
                <dd><span class="price-number">22,000</span>円<span class="price-unit">／1回</span></dd>
              </div>
              <div class="price-row">
                <dt>生ワクチン<span class="price-row-sub">1回接種</span></dt>
                <dd><span class="price-number">7,700</span>円<span class="price-unit">／1回</span></dd>
              </div>
            </dl>
            <p class="price-card-note">※ 料金はすべて税込です</p>
            <p class="price-card-note">※ 保険適用外のため、自費診療となります</p>
            <p class="price-card-note">※ シングリックスは2回で合計44,000円です</p>
            <a href="#nini" class="price-card-link">任意接種の詳しいご案内 →</a>
          </div>
          <div class="price-card price-card-teiki">
            <div class="price-card-header">
              <span class="price-card-badge badge-turquoise">今年度65・70・75歳などになる方</span>
              <h3 class="price-card-title">定期接種</h3>
              <p class="price-card-lead">仙台市の費用助成を受けて公費で行う接種</p>
            </div>
            <dl class="price-rows">
              <div class="price-row">
                <dt>シングリックス<span class="price-row-sub">2回接種</span></dt>
                <dd><span class="price-number">11,000</span>円<span class="price-label">（自己負担）</span><span class="price-unit">／1回</span></dd>
              </div>
              <div class="price-row">
                <dt>生ワクチン<span class="price-row-sub">1回接種</span></dt>
                <dd><span class="price-number">5,000</span>円<span class="price-label">（自己負担）</span><span class="price-unit">／1回</span></dd>
              </div>
            </dl>
            <p class="price-card-note">※ 令和9年3月31日（水）までの接種が対象です</p>
            <p class="price-card-note">※ 市民税非課税世帯の方などは無料です（確認書類の提示が必要）</p>
            <a href="#teiki" class="price-card-link">定期接種の詳しいご案内 →</a>
          </div>
        </div>
        <div class="price-cta">
          <LineCta lines={[
            "LINEのメニューから「その他予約」→「帯状疱疹ワクチン」を選んでご予約ください。"
          ]} />
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">LINEでの予約方法</h2>
        <p class="section-lead">帯状疱疹ワクチンは、メニューの<strong>「その他予約」</strong>からご予約いただけます。</p>
        <div class="reserve-guide">
          <LineReservationGuide variant="zoster-vaccine" />
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">2種類のワクチンの違い</h2>
        <p class="section-lead">定期接種・任意接種のどちらでも、2種類のうち1つを選んで接種します。</p>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr><th></th><th>シングリックス<br /><span class="compare-sub">（組換えワクチン）</span></th><th>生ワクチン<br /><span class="compare-sub">（乾燥弱毒生水痘ワクチン）</span></th></tr>
            </thead>
            <tbody>
              <tr><th>接種回数</th><td><strong>2回</strong>（2か月以上あけて、筋肉注射）</td><td>1回（皮下注射）</td></tr>
              <tr><th>予防効果<br />（接種後5年）</th><td><strong>9割程度</strong></td><td>4割程度</td></tr>
              <tr><th>免疫が落ちている方</th><td>接種できます</td><td><strong>接種できません</strong></td></tr>
              <tr><th>主な副反応</th><td>注射した場所の痛み（約8割）・腫れ、筋肉痛、だるさ、頭痛、発熱など。多くは2〜3日で治まります</td><td>注射した場所の赤み・かゆみ・腫れ</td></tr>
            </tbody>
          </table>
        </div>
        <p class="source-note">
          予防効果は厚生労働省の資料によるものです。報告ごとに条件が異なるため、単純な比較はできません。<br />
          ワクチンの選び方や帯状疱疹については、<a href="/articles/herpes-zoster" class="ref-link">帯状疱疹のページ</a>もご覧ください。
        </p>
      </div>
    </section>

    <section class="page-section">
      <div class="container">
        <h2 class="page-section-title">共通のご案内</h2>
        <p class="section-lead">任意接種・定期接種のどちらにも共通する内容です。</p>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>使用ワクチン</dt>
            <dd>
              シングリックス筋注用（GSK）、または乾燥弱毒生水痘ワクチン「ビケン」（阪大微研）
              <span class="spec-note">シングリックスは<strong>2か月以上あけて2回</strong>接種します。1回目から6か月後までに2回目を接種してください。2回目も、LINEからご予約ください。</span>
            </dd>
          </div>
          <div class="spec-row">
            <dt>接種できる時間</dt>
            <dd><div class="time-grid"><span class="time-day">平日（月・水〜金）</span><span class="time-range">17:00〜19:00</span><span class="time-day">土日</span><span class="time-range">14:00〜17:00</span></div><p class="spec-attention">予防接種は<strong>一般内科外来の時間帯</strong>で行っています。平日19:00以降・土日17:00以降は発熱外来の時間帯のため、接種は行っていません。</p><span class="spec-note">火曜日は休診です。臨時休診は<a href="/#hours" class="ref-link">診療日カレンダー</a>でご確認ください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>ご予約</dt>
            <dd>
              LINEのメニューから「その他予約」→「帯状疱疹ワクチン」を選んでご予約ください
              <p class="spec-attention">ワクチンはご予約をいただいてから取り寄せます。<strong>ご予約は接種日の3日前の15時まで</strong>です。ご予約の変更・キャンセルも、接種日の3日前の15時までにお願いします（それ以降はお電話でご連絡ください）。</p>
            </dd>
          </div>
          <div class="spec-row">
            <dt>予診票</dt>
            <dd>当院にご用意しています<span class="spec-note"><a href="/forms/zoster-vaccine-yoshinhyo.pdf" class="ref-link" target="_blank" rel="noopener noreferrer">こちら</a>から印刷してご持参いただくこともできます。</span></dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="page-section bg-turquoise" id="teiki">
      <div class="container">
        <h2 class="page-section-title">定期接種（仙台市）</h2>
        <p class="section-lead">
          仙台市の費用助成を受けて、公費で行う接種です。<br />
          当院は<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/teki/taijyouhousinn.html" class="ref-link" target="_blank" rel="noopener noreferrer">仙台市の高齢者帯状疱疹予防接種 登録医療機関</a>です。
        </p>
        <dl class="spec-list spec-list-teiki">
          <div class="spec-row">
            <dt>対象となる方</dt>
            <dd>
              仙台市に住民票のある、次のいずれかに当てはまる方
              <ul class="attention-sublist">
                <li>令和8年度中（令和9年3月31日まで）に<strong>65歳・70歳・75歳・80歳・85歳・90歳・95歳・100歳</strong>になる方</li>
                <li>60〜64歳の方で、ヒト免疫不全ウイルスによる免疫機能に障害のある方（身体障害者手帳1級相当）</li>
              </ul>
              <span class="spec-note">70歳以上の方は、令和7〜11年度の5年間に限った経過措置です。<strong>対象の年度を逃すと、その後は定期接種の対象になりません</strong>（任意接種となります）。以前に帯状疱疹にかかったことがある方も対象です。</span>
            </dd>
          </div>
          <div class="spec-row">
            <dt>自己負担額</dt>
            <dd>
              <div class="time-grid"><span class="time-day">シングリックス</span><span class="time-range">1回11,000円（2回で22,000円）</span><span class="time-day">生ワクチン</span><span class="time-range">5,000円</span></div>
              <span class="spec-note">生活保護世帯の方、市民税非課税世帯の方などは無料です。下の「無料になる方」をご覧ください。</span>
            </dd>
          </div>
          <div class="spec-row">
            <dt>接種期間</dt>
            <dd>令和9年3月31日（水）まで
              <p class="spec-attention">シングリックスで年度内に2回を終えるには、<strong>遅くとも令和9年1月中に1回目</strong>を接種する必要があります。お早めにご予約ください。</p>
            </dd>
          </div>
          <div class="spec-row">
            <dt>持ち物</dt>
            <dd>マイナンバーカード・健康保険証などの本人確認書類<span class="spec-note">60〜64歳で障害により対象となる方は、身体障害者手帳もお持ちください。仙台市からの案内ハガキがお手元になくても接種できます。</span></dd>
          </div>
          <div class="spec-row">
            <dt>接種後</dt>
            <dd>予防接種済証をお渡しします<span class="spec-note">接種の記録になりますので、大切に保管してください。</span></dd>
          </div>
          <div class="spec-row">
            <dt>健康被害が<br class="pc-only" />生じた場合</dt>
            <dd>予防接種法に基づく救済制度の対象となることがあります<span class="spec-note">定期接種は予防接種法に基づく接種のため、健康被害が接種によるものと厚生労働大臣が認定したときは、医療費・障害年金等の給付を受けられます。詳しくは<a href="https://www.city.sendai.jp/kenkoanzen-kansen/yobosesshu/images/kenkouhigaikyusaiseido.html" class="ref-link" target="_blank" rel="noopener noreferrer">副反応・予防接種健康被害救済制度について（仙台市）</a>をご覧ください。</span></dd>
          </div>
        </dl>

        <h3 class="sub-heading">自己負担金が無料になる方</h3>
        <div class="info-box">
          <p class="info-text">
            次に当てはまる方は、<strong>確認書類を受付でご提示いただくと無料</strong>になります。
          </p>
          <ul class="attention-sublist">
            <li><strong>生活保護世帯の方</strong> … 生活保護費支給票</li>
            <li><strong>市民税非課税世帯の方</strong> … 令和8年度 仙台市の介護保険料決定通知書（「市町村民税非課税世帯」と記載のあるもの）、または確認通知書（「自己負担金免除対象者です」と記載のあるもの）</li>
            <li><strong>中国残留邦人等支援給付制度を受給されている方</strong> … 同制度の本人確認証</li>
          </ul>
          <p class="info-note">
            ※ 確認書類のご提示がない場合は、自己負担額をお支払いいただきます。後日ご提示いただいた場合も返金はできませんので、ご注意ください。<br />
            ※ 介護保険料決定通知書をお持ちでない方は、仙台市への申請で「確認通知書」が届きます（10日程度かかります）。詳しくは<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/yobosesshu/jikohutankinmenjyo.html" class="ref-link" target="_blank" rel="noopener noreferrer">仙台市ホームページ</a>をご覧ください。
          </p>
        </div>
        <p class="source-note">
          出典：<a href="https://www.city.sendai.jp/kenkoanzen-kansen/kurashi/kenkotofukushi/kenkoiryo/kansensho/yobosesshu/teki/taijyouhousinn.html" class="ref-link" target="_blank" rel="noopener noreferrer">帯状疱疹の予防接種（定期接種）について（仙台市）</a>
        </p>
      </div>
    </section>

    <section class="page-section bg-coral" id="nini">
      <div class="container">
        <h2 class="page-section-title">任意接種</h2>
        <p class="section-lead">定期接種の対象ではない方が、自費で受ける接種です。</p>
        <dl class="spec-list">
          <div class="spec-row">
            <dt>対象となる方</dt>
            <dd>
              <ul class="attention-sublist">
                <li><strong>50歳以上</strong>の方（シングリックス・生ワクチンのどちらも選べます）</li>
                <li>病気や治療で免疫が落ちていて、帯状疱疹にかかるリスクが高い<strong>18歳以上</strong>の方（シングリックスのみ）</li>
              </ul>
              <span class="spec-note">今年度に定期接種の対象となる方は、定期接種で接種いただけます。数年以内に定期接種の対象年齢になる方は、先に任意接種を済ませると原則として定期接種の対象から外れますので、接種の時期に迷う場合はご相談ください。</span>
            </dd>
          </div>
          <div class="spec-row">
            <dt>料金（税込）</dt>
            <dd>
              <div class="time-grid"><span class="time-day">シングリックス</span><span class="time-range">1回22,000円（2回で44,000円）</span><span class="time-day">生ワクチン</span><span class="time-range">7,700円</span></div>
