---
// 採用ページのheroと、トップページのスタッフ募集欄で使う求人ビジュアル（Instagram広告と同じデザイン）。
// 背景の飾りの円は absolute 配置なので、呼び出し側の囲みに position: relative と overflow: hidden を付ける。
interface Props {
  titleTag?: "h1" | "h2" | "h3";
  /** トップページ用の小さい版 */
  compact?: boolean;
  showAccess?: boolean;
}

const { titleTag: Title = "h2", compact = false, showAccess = false } = Astro.props;
---

<div class:list={["hero-deco hero-deco--sun", { compact }]}></div>
<div class:list={["hero-deco hero-deco--mint", { compact }]}></div>
<div class:list={["hero-content", { compact }]}>
  <p class="hero-lead">夕方から働ける！</p>
  <Title class="hero-title"><span class="hero-marker">クリニック事務</span><br />スタッフ募集中</Title>
  <div class="hero-times">
    <div class="hero-time hero-time--weekday">
      <svg class="hero-time-icon" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M12 6.5V12l-3.5 3"/></svg>
      <div class="hero-time-day">平日</div>
      <div class="hero-time-big">17<small>時〜</small></div>
      <div class="hero-time-sub">土日は14時〜</div>
    </div>
    <div class="hero-time hero-time--weekend">
      <svg class="hero-time-icon" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="3"/><path d="M3 10h18M8 2.5v4M16 2.5v4"/><circle cx="15.5" cy="15.5" r="1.6" fill="#fff" stroke="none"/></svg>
      <div class="hero-time-day">週1回</div>
      <div class="hero-time-big hero-time-big--word">OK</div>
      <div class="hero-time-sub">受付事務</div>
    </div>
  </div>
  <div class="hero-points">
    <span class="hero-point">医療事務の<em>経験者</em>・<em>学生</em>さん歓迎</span>
    <span class="hero-point"><em>Wワーク</em>も歓迎</span>
  </div>
  <div class="hero-bottom">
    <div class="hero-price">時給 <strong>1,300</strong>円<span class="hero-price-note">（交通費支給）</span></div>
    {showAccess && <div class="hero-access">勾当台公園駅 徒歩2分 ― <span class="hero-access-sub">市役所となり・アーケード街からすぐ</span></div>}
  </div>
  <slot />
</div>

<style>
  .hero-deco {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-deco--sun {
    width: 280px;
    height: 280px;
    background: #FBC96B;
    opacity: 0.35;
    top: -100px;
    right: -80px;
  }
  .hero-deco--mint {
    width: 320px;
    height: 320px;
    background: var(--color-turquoise-bg);
    bottom: -120px;
    left: -100px;
  }
  .hero-deco--sun.compact {
    width: 200px;
    height: 200px;
    top: -80px;
    right: -60px;
  }
  .hero-deco--mint.compact {
    width: 220px;
    height: 220px;
    bottom: -90px;
    left: -80px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
  }

  /* 広告画像と同じ丸ゴシック。サブセットフォントなので、呼び出し側の slot（文言が変わりうる）には効かせない */
  .hero-lead,
  .hero-title,
  .hero-times,
  .hero-points,
  .hero-bottom {
    font-family: "M PLUS Rounded Hero", "M PLUS 1p", sans-serif;
  }

  .hero-lead {
    display: inline-block;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-coral);
    letter-spacing: 0.04em;
    transform: rotate(-3deg);
  }

  .hero-title {
    margin-top: 4px;
    font-size: 2.2rem;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--color-navy);
  }
  .hero-marker {
    background: linear-gradient(transparent 60%, #FBC96B 60%);
    padding: 0 4px;
  }

  .hero-times {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 28px;
  }

  .hero-time {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    box-shadow: 0 6px 0 rgba(30, 58, 95, 0.12);
  }
  .hero-time--weekday {
    background: var(--color-coral);
    transform: rotate(-4deg);
  }
  .hero-time--weekend {
    background: var(--color-turquoise);
    transform: rotate(4deg);
  }

  .hero-time-icon {
    width: 22px;
    height: 22px;
    margin-bottom: 2px;
  }
  .hero-time-day {
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    background: #fff;
    border-radius: 999px;
    padding: 0 10px;
    line-height: 1.6;
  }
  .hero-time--weekday .hero-time-day { color: var(--color-coral); }
  .hero-time--weekend .hero-time-day { color: var(--color-turquoise); }

  .hero-time-big {
    font-size: 2.9rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .hero-time-big small {
    font-size: 1.2rem;
    letter-spacing: 0;
  }
  .hero-time-big--word {
    font-size: 2.3rem;
  }
  .hero-time-sub {
    font-size: 0.75rem;
    font-weight: 800;
    margin-top: 2px;
  }

  .hero-points {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 26px;
  }
  .hero-point {
    background: #fff;
    border: 2px solid var(--color-navy);
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 0.9rem;
    font-weight: 900;
    color: var(--color-navy);
    white-space: nowrap;
  }
  .hero-point em {
    font-style: normal;
    color: var(--color-coral);
  }

  .hero-bottom {
    margin-top: 26px;
  }
  .hero-price {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .hero-price strong {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--color-coral);
  }
  .hero-price-note {
    font-size: 0.85rem;
    font-weight: 700;
    opacity: 0.7;
  }
  .hero-access {
    margin-top: 8px;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-navy);
  }

  /* トップページ用。採用ページより枠が狭いので丸とタイトルを詰めつつ、中の文字は大きめに保つ */
  .compact .hero-lead { font-size: 1.3rem; }
  .compact .hero-time-icon { width: 26px; height: 26px; }
  .compact .hero-title { font-size: 1.9rem; }
  .compact .hero-times { gap: 18px; margin-top: 22px; }
  .compact .hero-time { width: 164px; height: 164px; }
  .compact .hero-time-day { font-size: 0.9rem; }
  .compact .hero-time-big { font-size: 3.1rem; }
  .compact .hero-time-big small { font-size: 1.15rem; }
  .compact .hero-time-big--word { font-size: 2.45rem; }
  .compact .hero-time-sub { font-size: 0.72rem; }
  .compact .hero-point { font-size: 0.9rem; padding: 6px 14px; }
  .compact .hero-price { font-size: 1.15rem; }
  .compact .hero-price strong { font-size: 2rem; }
  .compact .hero-price-note { font-size: 0.9rem; }

  @media (max-width: 768px) {
    .hero-lead { font-size: 1.15rem; }
    .compact .hero-lead { font-size: 1.25rem; }
    .hero-title { font-size: 1.8rem; }
    .compact .hero-title { font-size: 1.8rem; }
    .hero-times { gap: 14px; }
    .hero-time { width: 148px; height: 148px; }
    /* 枠の幅が足りない端末では丸を縮める */
    .compact .hero-time { width: 150px; height: auto; aspect-ratio: 1; flex-shrink: 1; min-width: 0; container-type: inline-size; }
    .hero-time-day { font-size: 0.8rem; }
    .compact .hero-time-day { font-size: 0.88rem; }
    .hero-time-big { font-size: 2.5rem; }
    .compact .hero-time-big { font-size: min(2.85rem, 30cqi); }
    .hero-time-big small { font-size: 1rem; }
    .compact .hero-time-big small { font-size: min(1.15rem, 12cqi); }
    .hero-time-big--word { font-size: 1.95rem; }
    .compact .hero-time-big--word { font-size: min(2.2rem, 23.5cqi); }
    .hero-time-sub { font-size: 0.68rem; }
    .compact .hero-time-sub { font-size: 0.72rem; }
    .hero-point { font-size: 0.82rem; padding: 5px 10px; }
    .hero-access-sub { display: block; }
    /* トップページの枠は幅が狭いので、タグ2つが1段に収まるよう詰める */
    .compact .hero-points { gap: 6px; }
    .compact .hero-point { font-size: 0.68rem; padding: 4px 8px; }
  }
</style>
