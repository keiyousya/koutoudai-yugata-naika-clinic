---
import { Image } from "astro:assets";
import LineButton from "./LineButton.astro";
import richMenuImage from "../assets/line-guide/rich-menu.jpg";
import selectMenuImage from "../assets/line-guide/select-menu.jpg";

// general: トップの予約欄向け（友だち追加 → メニューから診療を選ぶ）
// afterpill: アフターピルページ向け（「その他予約」→「緊急避妊薬」）
interface Props {
  variant?: "general" | "afterpill";
}

const { variant = "general" } = Astro.props;

// 強調枠の位置はスクリーンショット上の割合（%）で指定する
type Highlight = { top: number; left: number; width: number; height: number };

interface Step {
  title: string;
  text: string;
  image?: ImageMetadata;
  alt?: string;
  highlight?: Highlight;
  // 友だち追加ボタンを表示する
  button?: boolean;
  // 画像なしで横幅いっぱいに表示する（最後の補足ステップ用）
  wide?: boolean;
}

const WHOLE_MENU: Highlight = { top: 58.5, left: 1.5, width: 97, height: 31 };
const OTHER_BUTTON: Highlight = { top: 75.5, left: 33.5, width: 33, height: 13.5 };
const AFTERPILL_CARD: Highlight = { top: 57, left: 3.2, width: 93.6, height: 13.2 };

const steps: Step[] =
  variant === "afterpill"
    ? [
        {
          title: "LINEで友だち追加",
          text: "下のボタンから当院のLINEを友だち追加してください。",
          button: true,
        },
        {
          title: "メニューの「その他予約」をタップ",
          text: "トーク画面の下にあるメニューから「その他予約」を押します。",
          image: richMenuImage,
          alt: "LINEのトーク画面下のメニュー。「その他予約」を押す",
          highlight: OTHER_BUTTON,
        },
        {
          title: "「緊急避妊薬（アフターピル）」を選ぶ",
          text: "診療の一覧から「緊急避妊薬（アフターピル）」を押します。",
          image: selectMenuImage,
          alt: "診療を選択する画面。「緊急避妊薬（アフターピル）」を選ぶ",
          highlight: AFTERPILL_CARD,
        },
        {
          title: "日時を選び、ご本人情報と問診を入力",
          text: "ご希望の日時を選んだあと、お名前などのご本人情報と問診にお答えいただくと予約完了です。",
          wide: true,
        },
      ]
    : [
        {
          title: "LINEで友だち追加",
          text: "下のボタンから当院のLINEを友だち追加してください。",
          button: true,
        },
        {
          title: "メニューから診療を選ぶ",
          text: "トーク画面の下のメニューから「一般内科」「発熱外来」「予防接種」のいずれかを押します。",
          image: richMenuImage,
          alt: "LINEのトーク画面下のメニュー。一般内科・発熱外来・予防接種・その他予約・マイページが並ぶ",
          highlight: WHOLE_MENU,
        },
        {
          title: "日時を選び、ご本人情報と問診を入力",
          text: "ご希望の日時を選んだあと、お名前などのご本人情報と問診にお答えいただくと予約完了です。",
          wide: true,
        },
      ];
---

<ol class="guide-steps" style={`--guide-columns:${steps.filter((s) => !s.wide).length};`}>
  {steps.map((step, i) => (
    <li class:list={["guide-step", { "guide-step-wide": step.wide }]}>
      <div class="guide-step-head">
        <span class="guide-step-number">{i + 1}</span>
        <p class="guide-step-title">{step.title}</p>
      </div>
      <p class="guide-step-text">{step.text}</p>
      {step.image ? (
        <div class="guide-phone">
          <Image src={step.image} alt={step.alt ?? ""} width={440} loading="lazy" class="guide-phone-image" />
          {step.highlight && (
            <span
              class="guide-highlight"
              aria-hidden="true"
              style={`top:${step.highlight.top}%;left:${step.highlight.left}%;width:${step.highlight.width}%;height:${step.highlight.height}%;`}
            />
          )}
        </div>
      ) : step.button && (
        <div class="guide-step-button">
          <LineButton label="友だち追加する" />
        </div>
      )}
    </li>
  ))}
</ol>

<style>
  .guide-steps {
    display: grid;
    grid-template-columns: repeat(var(--guide-columns), 1fr);
    gap: 16px;
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: left;
  }

  .guide-step {
    display: flex;
    flex-direction: column;
    padding: 18px 16px 20px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .guide-step-wide {
    grid-column: 1 / -1;
  }

  .guide-step-wide .guide-step-text {
    margin-bottom: 0;
  }

  .guide-step-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .guide-step-number {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #06c755;
    color: white;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .guide-step-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.5;
  }

  .guide-step-text {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 14px;
  }

  .guide-step-button {
    margin-top: auto;
    margin-bottom: auto;
    text-align: center;
  }

  .guide-phone {
    position: relative;
    width: 100%;
    max-width: 220px;
    margin: auto auto 0;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(30, 58, 95, 0.12);
  }

  .guide-phone-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .guide-highlight {
    position: absolute;
    border: 3px solid #e53935;
    border-radius: 10px;
    box-shadow: 0 0 0 3px rgba(229, 57, 53, 0.25);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .guide-steps {
      grid-template-columns: 1fr;
    }

    .guide-phone {
      max-width: 240px;
    }
  }
</style>
