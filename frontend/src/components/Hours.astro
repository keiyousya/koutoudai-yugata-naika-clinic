  #hours .monthly-cell .status { font-size: 0.85rem; font-weight: 700; }
  #hours .monthly-cell.open .status { color: var(--color-turquoise); }
  #hours .monthly-cell.closed .status { color: #888; }

  #hours .calendar-legend { display: flex; justify-content: center; gap: 24px; padding: 16px 20px; background: #fafafa; border-radius: 12px; }
  #hours .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--color-text-muted); }
  #hours .legend-icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; font-size: 0.8rem; font-weight: 700; }
  #hours .legend-icon.open { background: var(--color-turquoise-bg); color: var(--color-turquoise); }
  #hours .legend-icon.closed { background: #f5f5f5; color: #666; }
  #hours .legend-icon.temporary { background: #fff5e6; color: #e07a30; }

  /* 診療時間側 */
  #hours .info-side { width: 100%; }

  #hours .hours-main {
    text-align: center;
    margin-bottom: 24px;
    padding: 28px;
    background: var(--color-turquoise-bg);
    border-radius: 16px;
    border: 1px solid var(--color-turquoise);
