---
import { Image } from "astro:assets";
import interiorImage01 from "../assets/interior01.jpeg";
import interiorImage02 from "../assets/interior02.jpeg";
import interiorImage03 from "../assets/interior03.jpeg";
import ecgImage from "../assets/ecg.jpeg";
import echoImage from "../assets/echo.jpeg";
import HealthIcon from "./HealthIcon.astro";
import InfoCard from "./InfoCard.astro";
---

<section id="about" class="section about">
  <div class="container">
    <h2 class="section-title">当院について</h2>
    <div class="about-content">
      <div class="about-text">
        <p class="about-lead">
          お仕事帰りに、<br class="sp-only" />気軽に受診できるクリニックです。
        </p>
        <p class="about-description">
          健診での指摘の精査、生活習慣病など慢性疾患の管理から急な発熱・体調不良まで、<br />
          夕方以降のかかりつけ医として、お気軽にご相談ください。<br />
        </p>
        <div class="about-doctor-link-row">
          <a href="/doctor" class="about-doctor-link">院長紹介（経歴・ご挨拶）はこちら →</a>
        </div>

        <div class="interior-gallery" id="interiorGallery">
          <div class="interior-image-wrapper media-skeleton">
            <Image src={interiorImage01} alt="受付・待合室" width={480} loading="lazy" class="interior-image" />
            <span class="interior-label">受付・待合室</span>
          </div>
          <div class="interior-image-wrapper media-skeleton">
            <Image src={interiorImage02} alt="診察室" width={480} loading="lazy" class="interior-image" />
            <span class="interior-label">診察室</span>
          </div>
          <div class="interior-image-wrapper media-skeleton">
            <Image src={interiorImage03} alt="処置室" width={480} loading="lazy" class="interior-image" />
            <span class="interior-label">処置室</span>
          </div>
        </div>
        <div class="interior-dots" id="interiorDots">
          <button class="interior-dot active" aria-label="1枚目"></button>
          <button class="interior-dot" aria-label="2枚目"></button>
          <button class="interior-dot" aria-label="3枚目"></button>
        </div>

        <div class="about-features">
          <InfoCard icon="symbols/i_schedule_school_date_time" title="夕方〜夜間診療" variant="outlined">
            <p>平日17:00〜21:00まで診療。お仕事帰りにも立ち寄れます。</p>
          </InfoCard>
          <InfoCard icon="objects/calendar" title="土日・週末も診療" variant="outlined">
            <p>平日だけでなく、土曜・日曜も診療を行っています（14:00〜21:00）。週末や休日の通院にも対応できます。</p>
          </InfoCard>
          <InfoCard icon="symbols/geo_location" title="駅から徒歩2分" variant="outlined">
            <p>地下鉄南北線 勾当台公園駅から徒歩2分の好アクセス。</p>
          </InfoCard>
        </div>

        <div class="demographics-link-row">
          <a href="/patient-demographics" class="demographics-inline-link">当院の患者層（年代別割合）はこちら →</a>
        </div>

        <div class="medical-area">
          <h3 class="medical-heading">診療内容</h3>
          <p class="medical-note">
            下記以外の症状もお気軽にご相談ください。必要に応じて専門医療機関へのご紹介も行います。<br />
            ※ 健診で指摘を受けた項目の精査をご希望の方は、健診結果をお持ちください。
          </p>
          <div class="medical-columns">
            <InfoCard icon="symbols/clinical_fe" title="慢性疾患のかかりつけ">
              <p class="info-card__description">
                夕方以降の時間帯で継続的に生活習慣病などの管理・治療を行います。
              </p>
              <ul class="condition-list">
                <li class="condition-tag"><a href="/articles/hypertension" class="condition-link">高血圧</a></li>
                <li class="condition-tag"><a href="/articles/dyslipidemia" class="condition-link">コレステロール</a></li>
                <li class="condition-tag"><a href="/articles/dyslipidemia" class="condition-link">中性脂肪</a></li>
                <li class="condition-tag">尿酸・痛風</li>
                <li class="condition-tag"><a href="/articles/diabetes" class="condition-link">糖尿病</a></li>
                <li class="condition-tag">貧血</li>
                <li class="condition-tag">甲状腺</li>
                <li class="condition-tag">不眠</li>
                <li class="condition-tag">睡眠時無呼吸症候群</li>
              </ul>
            </InfoCard>

            <InfoCard icon="people/symptom" title="夜間の急な症状にも対応">
              <p class="info-card__description">
                夕方以降の急な発熱や体調不良に対応します。
              </p>
              <ul class="condition-list">
                <li class="condition-tag">発熱</li>
                <li class="condition-tag"><a href="/articles/common-cold" class="condition-link">かぜ症状</a></li>
                <li class="condition-tag"><a href="/articles/sore-throat" class="condition-link">のど</a></li>
                <li class="condition-tag"><a href="/articles/cough" class="condition-link">咳</a></li>
                <li class="condition-tag">腹痛・下痢</li>
                <li class="condition-tag"><a href="/articles/allergic-rhinitis" class="condition-link">花粉症・アレルギー</a></li>
                <li class="condition-tag">頻尿・排尿時痛</li>
                <li class="condition-tag">倦怠感・だるさ</li>
                <li class="condition-tag">動悸</li>
              </ul>
            </InfoCard>
          </div>

          <div id="fever">
          <InfoCard icon="devices/thermometer" title="発熱外来について" variant="outlined-coral" collapsible>
            <p>
              <strong>発熱外来は平日（月・水〜金）19:00〜21:00、土日17:00〜21:00</strong>です。発熱・咳・喉の痛みなどの症状がある方は、発熱外来の時間帯にご予約ください。インフルエンザ・新型コロナウイルスなどの迅速検査を行っています。
            </p>
            <p>
              当院は、<strong>受診歴の有無にかかわらず</strong>、発熱その他感染症を疑わせる症状を呈する患者様の受入れを行っております。感染防止対策として、一般診療と発熱外来で<strong>診療時間帯を分け</strong>、発熱患者様と他の患者様の動線が重ならないようにしております。
            </p>
          </InfoCard>
          </div>

        </div>

        <div class="specialty-area">
          <h3 class="specialty-area-heading">その他の診療</h3>
          <div class="specialty-grid">
            <a href="/allergen-immunotherapy" class="specialty-card-compact">
              <h4 class="specialty-compact-title">アレルゲン免疫療法</h4>
              <div class="specialty-compact-icon">
                <HealthIcon name="symbols/cardiogram" size={48} />
              </div>
              <span class="specialty-compact-link">詳しく見る →</span>
            </a>
            <a href="/afterpill" class="specialty-card-compact">
              <h4 class="specialty-compact-title">緊急避妊薬<br />（アフターピル）</h4>
              <div class="specialty-compact-icon">
                <HealthIcon name="devices/medicine_bottle" size={48} />
              </div>
              <span class="specialty-compact-link">詳しく見る →</span>
            </a>
            <a href="/flu-prevention" class="specialty-card-compact">
              <h4 class="specialty-compact-title">インフルエンザ<br />予防投与</h4>
              <div class="specialty-compact-icon">
                <HealthIcon name="medications/pills_2" size={48} />
              </div>
              <span class="specialty-compact-link">詳しく見る →</span>
            </a>
            <a href="/checkup" class="specialty-card-compact">
              <h4 class="specialty-compact-title">特定健診・基礎健診</h4>
              <div class="specialty-compact-icon">
                <HealthIcon name="objects/health_worker_form" size={48} />
              </div>
              <span class="specialty-compact-link">詳しく見る →</span>
            </a>
          </div>
          <div class="articles-link-row">
            <a href="/articles" class="articles-inline-link">病気について知る →</a>
          </div>
        </div>

        <div class="exam-area">
          <h3 class="medical-heading">検査・設備</h3>
          <p class="medical-note">
            院内で実施できる検査のご案内です。
          </p>
          <div class="exam-grid">
            <InfoCard icon="symbols/virus" title="迅速抗原検査" variant="coral" collapsible>
              <p class="info-card__description">
                院内で短時間に結果が得られる検査です。
              </p>
              <ul class="condition-list">
                <li class="condition-tag">インフルエンザA / B</li>
                <li class="condition-tag">新型コロナウイルス</li>
                <li class="condition-tag">溶連菌</li>
              </ul>
              <p class="info-card__note">※ インフルエンザ予防投与については<a href="/flu-prevention" class="info-card__link--inline">こちら</a></p>
            </InfoCard>

            <InfoCard icon="devices/syringe" title="検体検査" variant="coral" collapsible>
              <p class="info-card__description">
                血液検査・尿検査などは外部検査機関に委託して実施します。<a href="#blood-test" class="info-card__link--inline">結果は後日お伝えいたします。</a>
              </p>
              <ul class="condition-list">
                <li class="condition-tag">糖尿病</li>
                <li class="condition-tag">脂質異常症</li>
                <li class="condition-tag">尿酸</li>
                <li class="condition-tag">貧血</li>
                <li class="condition-tag">甲状腺</li>
                <li class="condition-tag">アレルギー</li>
                <li class="condition-tag">性感染症</li>
              </ul>
              <p class="info-card__note">※ アレルギー検査は39項目のセット検査が可能です。</p>
              <p class="info-card__note">※ 性感染症はクラミジア・淋菌・梅毒・HIV・B型肝炎の検査が可能です。</p>
              <p class="info-card__note">※ その他、症状に応じて必要な検査を行います。</p>
            </InfoCard>

            <InfoCard icon="symbols/cardiogram_e" title="12誘導心電図" variant="coral" collapsible>
              <p class="info-card__description">
                不整脈や狭心症など、心臓に関わる症状の評価に用います。
              </p>
              <div class="info-card__image-frame media-skeleton">
                <Image src={ecgImage} alt="12誘導心電図" width={320} loading="lazy" class="info-card__image" />
              </div>
              <span class="info-card__device">日本光電 ECG-3250</span>
            </InfoCard>

            <InfoCard icon="devices/ultrasound_scanner" title="超音波検査（エコー）" variant="coral" collapsible>
              <p class="info-card__description">
                腹部・腎臓・頸動脈・甲状腺などの検査を行います。
              </p>
              <div class="info-card__image-frame media-skeleton">
                <Image src={echoImage} alt="超音波検査装置" width={320} loading="lazy" class="info-card__image" />
              </div>
              <span class="info-card__device">キャノンメディカルシステムズ Aplio go / LE</span>
            </InfoCard>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .condition-link {
    color: inherit;
    text-decoration: none;
  }

  .condition-link:hover {
    opacity: 0.7;
  }

  .about {
    background: white;
  }

  .about-content {
    max-width: 960px;
    margin: 0 auto;
  }

  .about-lead {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-navy);
    text-align: center;
    margin-bottom: 24px;
    line-height: 1.9;
  }

  .about-description {
    text-align: center;
    color: var(--color-text-secondary);
    margin-bottom: 48px;
    line-height: 1.9;
    font-size: 0.9rem;
  }

  .about-doctor-link-row {
    text-align: center;
    margin-top: -36px;
    margin-bottom: 48px;
  }

  .about-doctor-link {
    font-size: 0.85rem;
    color: var(--color-turquoise);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 600;
  }

  .demographics-link-row {
    margin-top: 24px;
    text-align: center;
  }

  .demographics-inline-link {
    font-size: 0.85rem;
    color: var(--color-turquoise);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .demographics-inline-link:hover {
    opacity: 0.7;
  }

  .articles-link-row {
    margin-top: 28px;
    text-align: center;
  }

  .articles-inline-link {
    font-size: 0.85rem;
    color: var(--color-turquoise);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: opacity 0.2s;
  }

  .articles-inline-link:hover {
    opacity: 0.7;
  }

  .about-features {
    display: grid;
    gap: 20px;
  }

  .medical-area {
    margin-top: 64px;
  }

  .medical-heading {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-navy);
    text-align: center;
    margin-bottom: 14px;
    letter-spacing: 0.04em;
  }

  .medical-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 32px;
  }


  .medical-note {
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 28px;
  }


  .specialty-area {
    margin-top: 48px;
  }

  .specialty-area-heading {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 16px;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .specialty-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .specialty-card-compact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 16px;
    background: white;
    border: 1px solid var(--color-turquoise);
    border-radius: 16px;
    text-align: center;
    text-decoration: none;
    transition: box-shadow 0.2s;
  }

  .specialty-card-compact:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .specialty-compact-title {
    flex-grow: 1;
    display: flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.4;
  }

  .specialty-compact-icon {
    color: var(--color-turquoise);
    margin: 12px 0 20px;
  }

  .specialty-compact-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-turquoise);
  }


  .interior-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 48px;
  }

  .interior-image-wrapper {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }

  .interior-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .interior-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 12px;
    background: linear-gradient(transparent, rgba(30, 58, 95, 0.7));
    color: white;
    font-size: 0.78rem;
    font-weight: 500;
    text-align: center;
    letter-spacing: 0.06em;
  }

  .interior-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-bottom: 32px;
  }

  .interior-dot {
    all: unset;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border);
    cursor: pointer;
    transition: background 0.2s;
  }

  .interior-dot.active {
    background: var(--color-turquoise);
  }


  .exam-area {
    margin-top: 64px;
  }

  .exam-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 28px;
  }




  .sp-only {
    display: none;
  }

  @media (max-width: 768px) {
    .sp-only {
      display: inline;
    }

    .about-lead {
      font-size: 1rem;
    }

    .about-description {
      font-size: 0.9rem;
      text-align: left;
    }

    .medical-area {
      margin-top: 40px;
    }

    .medical-heading {
      font-size: 1rem;
      margin-bottom: 20px;
    }

    .medical-columns {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .medical-note {
      text-align: left;
      font-size: 0.9rem;
    }

    .interior-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 12px;
      margin-bottom: 12px;
    }

    .interior-gallery::-webkit-scrollbar {
      display: none;
    }

    .interior-gallery .interior-image-wrapper {
      flex: 0 0 85%;
      scroll-snap-align: center;
      border-radius: 16px;
    }

    .interior-gallery .interior-image-wrapper:first-child {
      margin-left: 7.5%;
    }

    .interior-gallery .interior-image-wrapper:last-child {
      margin-right: 7.5%;
    }

    .interior-gallery .interior-image-wrapper.is-clone {
      scroll-snap-align: none;
    }

    .interior-dots {
      display: flex;
    }

    .exam-area {
      margin-top: 40px;
    }

    .exam-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }


    .specialty-grid {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .specialty-area {
      margin-top: 32px;
    }

    .specialty-card-compact {
      padding: 18px 12px;
    }

    .specialty-compact-title {
      font-size: 0.82rem;
    }

  }
</style>

<script>
  const gallery = document.getElementById('interiorGallery');
  const dotsContainer = document.getElementById('interiorDots');
  if (gallery && dotsContainer) {
    const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('.interior-dot');
    const slides = gallery.querySelectorAll('.interior-image-wrapper');

    const realCount = slides.length;

    // 無限スクロール用: 前後にクローンを追加
    if (window.matchMedia('(max-width: 768px)').matches) {
      const firstClone = slides[0].cloneNode(true) as HTMLElement;
      const lastClone = slides[realCount - 1].cloneNode(true) as HTMLElement;
      firstClone.classList.add('is-clone');
      lastClone.classList.add('is-clone');
      gallery.appendChild(firstClone);
      gallery.insertBefore(lastClone, slides[0]);
    }

    const allSlides = gallery.querySelectorAll('.interior-image-wrapper');
    let currentIndex = 0;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let isScrolling = false;

    // クローン分のオフセット（SPのみクローンあり）
    const offset = window.matchMedia('(max-width: 768px)').matches ? 1 : 0;

    function getSlideLeft(index: number) {
      const el = allSlides[index + offset] as HTMLElement;
      return el.offsetLeft - (gallery.offsetWidth - el.offsetWidth) / 2;
    }

    function scrollToIndex(index: number, smooth = true) {
      isScrolling = true;
      gallery.scrollTo({ left: getSlideLeft(index), behavior: smooth ? 'smooth' : 'instant' });
      currentIndex = index;
      dots.forEach((d, i) => d.classList.toggle('active', i === index));
      setTimeout(() => { isScrolling = false; }, smooth ? 400 : 50);
    }

    function updateDots() {
      if (isScrolling) return;
      const scrollCenter = gallery.scrollLeft + gallery.offsetWidth / 2;
      let closest = 0;
      let minDist = Infinity;
      for (let i = 0; i < realCount; i++) {
        const el = allSlides[i + offset] as HTMLElement;
        const center = el.offsetLeft + el.offsetWidth / 2;
        const dist = Math.abs(scrollCenter - center);
        if (dist < minDist) { minDist = dist; closest = i; }
      }
      currentIndex = closest;
      dots.forEach((d, i) => d.classList.toggle('active', i === closest));
    }

    // スクロール終了時にクローン位置なら本体にジャンプ
    let scrollEndTimer: ReturnType<typeof setTimeout>;
    gallery.addEventListener('scroll', () => {
      updateDots();
      clearTimeout(scrollEndTimer);
      scrollEndTimer = setTimeout(() => {
        if (!offset) return;
        const scrollCenter = gallery.scrollLeft + gallery.offsetWidth / 2;
        // 末尾クローン（= index 0のコピー）に到達
        const lastCloneEl = allSlides[realCount + offset] as HTMLElement;
        if (scrollCenter >= lastCloneEl.offsetLeft) {
          scrollToIndex(0, false);
        }
        // 先頭クローン（= 最後のコピー）に到達
        const firstCloneEl = allSlides[0] as HTMLElement;
        const firstRealEl = allSlides[offset] as HTMLElement;
        if (scrollCenter <= firstCloneEl.offsetLeft + firstCloneEl.offsetWidth / 2 &&
            gallery.scrollLeft < firstRealEl.offsetLeft - gallery.offsetWidth) {
          scrollToIndex(realCount - 1, false);
        }
      }, 100);
    });

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(() => {
        const next = currentIndex + 1;
        if (next >= realCount) {
          // 末尾クローンへスムーズスクロール→本体にジャンプ
          isScrolling = true;
          const cloneEl = allSlides[realCount + offset] as HTMLElement;
          gallery.scrollTo({ left: cloneEl.offsetLeft - (gallery.offsetWidth - cloneEl.offsetWidth) / 2, behavior: 'smooth' });
          dots.forEach((d, i) => d.classList.toggle('active', i === 0));
          setTimeout(() => {
            scrollToIndex(0, false);
          }, 500);
        } else {
          scrollToIndex(next);
        }
      }, 4000);
    }

    function stopAuto() {
      if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
    }

    gallery.addEventListener('touchstart', stopAuto, { passive: true });
    gallery.addEventListener('touchend', () => setTimeout(startAuto, 5000), { passive: true });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        scrollToIndex(i);
        stopAuto();
        setTimeout(startAuto, 5000);
      });
    });

    // 初期位置をセット＆自動送り開始（SPのみ）
    if (offset) {
      scrollToIndex(0, false);
      startAuto();
    }
  }
</script>
