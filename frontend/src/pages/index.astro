---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Hours from "../components/Hours.astro";
import Access from "../components/Access.astro";
import Reservation from "../components/Reservation.astro";
import News from "../components/News.astro";
import VaccineBanner from "../components/VaccineBanner.astro";
import Articles from "../components/Articles.astro";
import AppropriateCareBanner from "../components/AppropriateCareBanner.astro";
import InsuranceBanner from "../components/InsuranceBanner.astro";
import DisclosureLinks from "../components/DisclosureLinks.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="勾当台夕方内科クリニック | 仙台で夜21時まで・土日も診療｜発熱外来・生活習慣病・健診再検査・予防接種"
  description="仙台市で夜21時まで・土日も診療の内科クリニック。発熱外来は平日19〜21時・土日17〜21時（一般診療と時間帯・診療スペースを分けて対応）。咳・風邪症状、高血圧・糖尿病など生活習慣病の管理、健診再検査、インフルエンザ・新型コロナウイルス予防接種、インフルエンザ予防投与、アレルゲン免疫療法、緊急避妊薬（アフターピル）夜間処方、性感染症検査に対応。勾当台公園駅徒歩2分。"
>
  <Header />
  <main>
    <Hero />
    <InsuranceBanner />
    <News />
    <VaccineBanner />
    <AppropriateCareBanner />
    <DisclosureLinks />
    <About />
    <Hours />
    <Reservation />
    <Access />
    <Articles />
  </main>
  <Footer />
</Layout>
