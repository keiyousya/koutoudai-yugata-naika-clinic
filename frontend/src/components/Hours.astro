---
// 7月からのスケジュール（2段）
const days = ["月", "火", "水", "木", "金", "土", "日"];
// 14-17時: 土日のみ
const scheduleJuly14 = [
  { day: "月", open: false, na: true },
  { day: "火", open: false, na: true },
  { day: "水", open: false, na: true },
  { day: "木", open: false, na: true },
  { day: "金", open: false, na: true },
  { day: "土", open: true },
  { day: "日", open: true },
];
// 17-21時: 火曜以外
const scheduleJuly17 = [
  { day: "月", open: true },
  { day: "火", open: false, na: true },
  { day: "水", open: true },
  { day: "木", open: true },
  { day: "金", open: true },
  { day: "土", open: true },
  { day: "日", open: true },
];
---

<section id="hours" class="section hours">
  <div class="container">
    <h2 class="section-title">診療時間</h2>
    <div class="hours-layout">
      <!-- 左側：カレンダー（APIから動的取得） -->
      <div class="calendar-side">
        <div class="month-tabs" id="monthTabs">
          <button class="month-tab active" data-month="0">--月</button>
          <button class="month-tab" data-month="1">--月</button>
        </div>

        <div class="calendar-container">
          <button class="calendar-nav prev" id="prevMonth" aria-label="前の月">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>

          <div class="calendar-slider">
            <div class="calendar-track" id="calendarTrack">
              <!-- スケルトン（JS描画後に置き換え） -->
              <div class="monthly-calendar">
                <div class="monthly-header"><span>&nbsp;</span></div>
                <div class="monthly-weekdays">
                  <div class="weekday sunday">日</div><div class="weekday">月</div><div class="weekday">火</div><div class="weekday">水</div><div class="weekday">木</div><div class="weekday">金</div><div class="weekday saturday">土</div>
                </div>
                <div class="monthly-grid">
                  {Array.from({ length: 35 }).map(() => (
                    <div class="monthly-cell">
                      <span class="cal-skeleton cal-skeleton--date"></span>
                      <span class="cal-skeleton cal-skeleton--status"></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <button class="calendar-nav next" id="nextMonth" aria-label="次の月">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
        </div>

        <div class="calendar-legend">
          <div class="legend-item">
            <span class="legend-icon open">○</span>
            <span>診療</span>
          </div>
          <div class="legend-item">
            <span class="legend-icon closed">休</span>
            <span>休診</span>
          </div>
          <div class="legend-item">
            <span class="legend-icon temporary">休</span>
            <span>臨時休診</span>
          </div>
        </div>
      </div>

      <!-- 右側：診療時間 -->
      <div class="info-side">
        <!-- 診療時間 -->
        <div class="hours-main" id="hoursJuly">
          <div class="hours-block">
            <span class="hours-block-label">平日（月・水〜金）</span>
            <div class="hours-primary">17:00 - 21:00</div>
            <div class="hours-sub">発熱外来 19:00-21:00</div>
          </div>
          <div class="hours-block">
            <span class="hours-block-label">土日</span>
            <div class="hours-primary">14:00 - 21:00</div>
            <div class="hours-sub">発熱外来 18:00-21:00</div>
          </div>
        </div>

        <div class="hours-last-reception">
          <span class="last-reception-text">受付開始 <strong>平日 17:00</strong> / <strong>土日 14:00</strong></span>
          <span class="last-reception-text">最終受付 <strong>20:50</strong><br class="sp-only" />（LINE・電話予約の当日最終）</span>
          <span class="reception-note">※ 診療開始前は院内でお待ちいただけません</span>
        </div>

        <!-- 診療日カレンダー -->
        <div class="schedule-table two-rows" id="scheduleJuly">
          <div class="schedule-header">
            <span>診療日カレンダー</span>
          </div>
          <div class="schedule-days">
            <div class="schedule-day-spacer"></div>
            {days.map((day) => (
              <div class="schedule-day-header">{day}</div>
            ))}
          </div>
          <div class="schedule-row">
            <div class="schedule-time-label">14-17時</div>
            <div class="schedule-grid-row">
              {scheduleJuly14.map((item) => (
                <div class={`schedule-cell ${item.open ? "open" : "closed"} ${item.na ? "na" : ""}`}>
                  <span class="status">{item.na ? "-" : (item.open ? "○" : "休")}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="schedule-row">
            <div class="schedule-time-label">17-21時</div>
            <div class="schedule-grid-row">
              {scheduleJuly17.map((item) => (
                <div class={`schedule-cell ${item.open ? "open" : "closed"} ${item.na ? "na" : ""}`}>
                  <span class="status">{item.na ? "-" : (item.open ? "○" : "休")}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- 診療日説明 -->
        <div class="hours-info" id="infoJuly">
          <div class="info-item">
            <span class="info-icon open">○</span>
            <span>診療日（月・水〜日）</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style is:global>
  #hours {
    background: white;
  }

  #hours .hours-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: start;
  }

  /* カレンダー側 */
  #hours .calendar-side { width: 100%; }

  #hours .month-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    justify-content: center;
  }

  #hours .month-tab {
    padding: 10px 28px;
    background: white;
    border: 2px solid var(--color-border);
    border-radius: 24px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  #hours .month-tab:hover { border-color: var(--color-turquoise); color: var(--color-turquoise); }
  #hours .month-tab.active { background: var(--color-turquoise); border-color: var(--color-turquoise); color: white; }

  #hours .calendar-container { position: relative; margin-bottom: 20px; }
  #hours .calendar-slider { overflow: hidden; border-radius: 16px; }
  #hours .calendar-track { display: flex; transition: transform 0.3s ease-in-out; }

  #hours .monthly-calendar {
    min-width: 100%;
    flex-shrink: 0;
    background: white;
    border: 1px solid #d0e8ec;
    border-radius: 16px;
    overflow: hidden;
  }

  #hours .calendar-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border: 1px solid #d0e8ec;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-navy);
    transition: all 0.2s;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  #hours .calendar-nav:hover:not(:disabled) { background: var(--color-turquoise-bg); border-color: var(--color-turquoise); color: var(--color-turquoise); }
  #hours .calendar-nav:disabled { cursor: not-allowed; }
  #hours .calendar-nav.prev { left: -22px; }
  #hours .calendar-nav.next { right: -22px; }

  #hours .monthly-header {
    background: var(--color-navy);
    color: white;
    padding: 16px;
    text-align: center;
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  #hours .monthly-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    background: #f8f8f8;
    border-bottom: 1px solid var(--color-border);
  }

  #hours .monthly-weekdays .weekday { text-align: center; padding: 10px 4px; font-size: 0.85rem; font-weight: 500; color: var(--color-text-muted); }
  #hours .monthly-weekdays .weekday.sunday { color: #e05a5a; }
  #hours .monthly-weekdays .weekday.saturday { color: #4a90d9; }

  #hours .monthly-grid { display: grid; grid-template-columns: repeat(7, 1fr); }

  #hours .monthly-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 4px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    min-height: 60px;
  }

  #hours .monthly-cell:nth-child(7n) { border-right: none; }
  #hours .monthly-cell.empty { background: #fafafa; }
  #hours .monthly-cell.closed { background: #f9f9f9; }
  #hours .monthly-cell.holiday { background: #f0f8f9; }
  #hours .monthly-cell.temporary { background: #fff5e6; }
  #hours .monthly-cell.temporary .status { color: #e07a30; }

  #hours .monthly-cell .date { font-size: 0.95rem; font-weight: 500; color: var(--color-navy); margin-bottom: 4px; }
  #hours .monthly-cell .date.sunday { color: #e05a5a; }
  #hours .monthly-cell .date.saturday { color: #4a90d9; }

  #hours .monthly-cell .status { font-size: 0.85rem; font-weight: 700; }
  #hours .monthly-cell.open .status { color: var(--color-turquoise); }
  #hours .monthly-cell.closed .status { color: #888; }

  #hours .calendar-legend { display: flex; justify-content: center; gap: 24px; padding: 16px 20px; background: #fafafa; border-radius: 12px; }
  #hours .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--color-text-muted); }
  #hours .legend-icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; font-size: 0.8rem; font-weight: 700; }
  #hours .legend-icon.open { background: var(--color-turquoise-bg); color: var(--color-turquoise); }
  #hours .legend-icon.closed { background: #f5f5f5; color: #666; }
  #hours .legend-icon.temporary { background: #fff5e6; color: #e07a30; }

  /* 診療時間側 */
  #hours .info-side { width: 100%; }

  #hours .hours-main {
    text-align: center;
    margin-bottom: 24px;
    padding: 28px;
    background: var(--color-turquoise-bg);
    border-radius: 16px;
    border: 1px solid var(--color-turquoise);
  }

  #hours .hours-primary { font-size: 1.8rem; font-weight: 700; color: var(--color-navy); letter-spacing: 0.02em; }
  #hours .hours-sub { font-size: 0.9rem; color: var(--color-text-muted); margin-top: 10px; }

  #hours .hours-block { padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid rgba(62, 184, 200, 0.3); }
  #hours .hours-block:last-child { padding-bottom: 0; margin-bottom: 0; border-bottom: none; }
  #hours .hours-block-label { display: block; font-size: 0.9rem; font-weight: 600; color: var(--color-navy); margin-bottom: 10px; }

  #hours .hours-last-reception { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; margin-bottom: 24px; }
  #hours .last-reception-text { font-size: 1rem; color: var(--color-text-muted); }
  #hours .reception-note { font-size: 0.82rem; color: var(--color-text-muted); margin-top: 2px; text-wrap: balance; }
  #hours .last-reception-text strong { font-weight: 700; color: var(--color-navy); }

  #hours .schedule-table { background: white; border-radius: 16px; overflow: hidden; border: 1px solid #d0e8ec; margin-bottom: 20px; }
  #hours .schedule-header { background: var(--color-navy); color: white; padding: 12px; text-align: center; font-weight: 500; font-size: 0.85rem; letter-spacing: 0.03em; }
  #hours .schedule-grid { display: grid; grid-template-columns: repeat(7, 1fr); }

  #hours .schedule-cell { display: flex; flex-direction: column; align-items: center; padding: 16px 6px; border-right: 1px solid var(--color-border); }
  #hours .schedule-cell:last-child { border-right: none; }
  #hours .schedule-cell .day { font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 6px; }
  #hours .schedule-cell .status { font-size: 1rem; font-weight: 700; }
  #hours .schedule-cell.open .status { color: var(--color-turquoise); }
  #hours .schedule-cell.closed .status { color: #888; }
  #hours .schedule-cell.closed { background: #f9f9f9; }
  #hours .schedule-cell.na { background: #fafafa; }
  #hours .schedule-cell.na .status { color: #ccc; }

  /* 2段レイアウト用 */
  #hours .schedule-table.two-rows .schedule-days { display: grid; grid-template-columns: 70px repeat(7, 1fr); background: #f8f8f8; border-bottom: 1px solid var(--color-border); }
  #hours .schedule-day-spacer { border-right: 1px solid var(--color-border); }
  #hours .schedule-day-header { text-align: center; padding: 10px 4px; font-size: 0.85rem; font-weight: 500; color: var(--color-text-muted); }

  #hours .schedule-row { display: flex; border-bottom: 1px solid var(--color-border); }
  #hours .schedule-row:last-child { border-bottom: none; }
  #hours .schedule-time-label { display: flex; align-items: center; justify-content: center; width: 70px; flex-shrink: 0; font-size: 0.65rem; font-weight: 500; color: var(--color-text-muted); background: #f8f8f8; border-right: 1px solid var(--color-border); }
  #hours .schedule-grid-row { display: grid; grid-template-columns: repeat(7, 1fr); flex: 1; }
  #hours .schedule-grid-row .schedule-cell { padding: 12px 4px; }

  #hours .hours-info { display: flex; justify-content: center; gap: 24px; margin-bottom: 20px; }
  #hours .info-item { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--color-text-muted); }
  #hours .info-icon { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; font-size: 0.85rem; font-weight: 700; }
  #hours .info-icon.open { background: var(--color-turquoise-bg); color: var(--color-turquoise); }
  #hours .info-icon.closed { background: #f5f5f5; color: #666; }

  /* カレンダースケルトン */
  #hours .cal-skeleton {
    display: block;
    background: #eee;
    border-radius: 4px;
    animation: cal-skeleton-pulse 1.5s ease-in-out infinite;
  }

  #hours .cal-skeleton--date { width: 1.2em; height: 0.95rem; margin-bottom: 4px; }
  #hours .cal-skeleton--status { width: 1.2em; height: 0.85rem; }

  @keyframes cal-skeleton-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  #hours .sp-only { display: none; }

  @media (max-width: 900px) {
    #hours .hours-layout { grid-template-columns: 1fr; gap: 32px; }
    #hours .calendar-side { max-width: 500px; margin: 0 auto; }
    #hours .info-side { max-width: 500px; margin: 0 auto; }
  }

  @media (max-width: 768px) {
    #hours .sp-only { display: inline; }
    #hours .monthly-cell { padding: 8px 2px; min-height: 50px; }
    #hours .monthly-cell .date { font-size: 0.85rem; }
    #hours .monthly-cell .status { font-size: 0.75rem; }
    #hours .schedule-cell { padding: 12px 4px; }
    #hours .schedule-cell .day { font-size: 0.8rem; }
    #hours .schedule-cell .status { font-size: 0.9rem; }
    #hours .hours-info { flex-direction: column; align-items: center; gap: 10px; }
    #hours .calendar-legend { flex-direction: row; gap: 20px; }
    #hours .calendar-nav.prev { left: -16px; }
    #hours .calendar-nav.next { right: -16px; }
    #hours .calendar-nav { width: 36px; height: 36px; }
    #hours .calendar-nav svg { width: 20px; height: 20px; }
  }
</style>

<script>
  const PROCYON_BASE = import.meta.env.PUBLIC_PROCYON_BASE_URL || 'https://api.procyon.helix.keiyousya.com';
  const PROCYON_TENANT = import.meta.env.PUBLIC_PROCYON_TENANT || 'koutoudai-yugata-naika';

  interface CalendarDate {
    date: string;
    dayOfWeek: number;
    status: 'open' | 'regular_closed' | 'holiday_closed' | 'temporary_closed';
    holidayName?: string;
  }

  interface CalendarMonth {
    month: string;
    dates: CalendarDate[];
  }

  interface CalendarResponse {
    months: CalendarMonth[];
  }

  const WEEKDAY_LABELS = ['日', '月', '火', '水', '木', '金', '土'];

  // 当月・翌月の YYYY-MM を取得
  function getTargetMonths(): string[] {
    const now = new Date();
    const m1 = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
    const next = new Date(now.getFullYear(), now.getMonth() + 1, 1);
    const m2 = `${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}`;
    return [m1, m2];
  }

  function renderMonthCalendar(monthData: CalendarMonth): string {
    const [year, month] = monthData.month.split('-').map(Number);
    const label = `${year}年${month}月`;

    // 月の1日の曜日（日曜始まり）
    const firstDow = new Date(year, month - 1, 1).getDay();

    // 先頭の空セル
    let cells = '';
    for (let i = 0; i < firstDow; i++) {
      cells += '<div class="monthly-cell empty"></div>';
    }

    // 日付セル
    for (const d of monthData.dates) {
      const dayNum = new Date(d.date).getDate();
      const isOpen = d.status === 'open';
      const isHoliday = d.status === 'holiday_closed';
      const isTemporary = d.status === 'temporary_closed';
      const isClosed = !isOpen;

      const cellClasses = [
        'monthly-cell',
        isOpen ? 'open' : 'closed',
        isHoliday ? 'holiday' : '',
        isTemporary ? 'temporary' : '',
      ].filter(Boolean).join(' ');

      const dateClasses = [
        'date',
        d.dayOfWeek === 0 ? 'sunday' : '',
        d.dayOfWeek === 6 ? 'saturday' : '',
      ].filter(Boolean).join(' ');

      cells += `<div class="${cellClasses}">
        <span class="${dateClasses}">${dayNum}</span>
        <span class="status">${isOpen ? '○' : '休'}</span>
      </div>`;
    }

    // 末尾の空セル（7の倍数に合わせる）
    const totalCells = firstDow + monthData.dates.length;
    const remainder = totalCells % 7;
    if (remainder > 0) {
      for (let i = 0; i < 7 - remainder; i++) {
        cells += '<div class="monthly-cell empty"></div>';
      }
    }

    const weekdayHeaders = WEEKDAY_LABELS.map((day, i) => {
      const cls = i === 0 ? 'weekday sunday' : i === 6 ? 'weekday saturday' : 'weekday';
      return `<div class="${cls}">${day}</div>`;
    }).join('');

    return `<div class="monthly-calendar">
      <div class="monthly-header"><span>${label}</span></div>
      <div class="monthly-weekdays">${weekdayHeaders}</div>
      <div class="monthly-grid">${cells}</div>
    </div>`;
  }

  let currentMonth = 0;
  const totalMonths = 2;
  const track = document.getElementById('calendarTrack');
  const prevBtn = document.getElementById('prevMonth') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('nextMonth') as HTMLButtonElement | null;
  const monthTabsContainer = document.getElementById('monthTabs');

  function updateSlider() {
    if (track) {
      track.style.transform = `translateX(-${currentMonth * 100}%)`;
    }
    if (prevBtn) {
      prevBtn.disabled = currentMonth === 0;
      prevBtn.style.opacity = currentMonth === 0 ? '0.3' : '1';
    }
    if (nextBtn) {
      nextBtn.disabled = currentMonth === totalMonths - 1;
      nextBtn.style.opacity = currentMonth === totalMonths - 1 ? '0.3' : '1';
    }
    monthTabsContainer?.querySelectorAll('.month-tab').forEach((tab, i) => {
      tab.classList.toggle('active', i === currentMonth);
    });
  }

  function bindNavigation() {
    prevBtn?.addEventListener('click', () => {
      if (currentMonth > 0) { currentMonth--; updateSlider(); }
    });
    nextBtn?.addEventListener('click', () => {
      if (currentMonth < totalMonths - 1) { currentMonth++; updateSlider(); }
    });
    monthTabsContainer?.querySelectorAll('.month-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentMonth = parseInt((tab as HTMLElement).dataset.month || '0');
        updateSlider();
      });
    });
  }

  async function loadCalendar() {
    const months = getTargetMonths();

    // タブのラベルを設定
    if (monthTabsContainer) {
      const tabs = monthTabsContainer.querySelectorAll('.month-tab');
      months.forEach((m, i) => {
        const monthNum = parseInt(m.split('-')[1]);
        if (tabs[i]) tabs[i].textContent = `${monthNum}月`;
      });
    }

    try {
      const url = new URL(`${PROCYON_BASE}/${PROCYON_TENANT}/v1/consultation-calendar`);
      months.forEach(m => url.searchParams.append('months', m));

      const res = await fetch(url.toString());
      if (!res.ok) throw new Error('fetch failed');
      const data: CalendarResponse = await res.json();

      if (track) {
        track.innerHTML = data.months.map(renderMonthCalendar).join('');
      }
    } catch {
      if (track) {
        track.innerHTML = `<div class="monthly-calendar">
          <div class="monthly-header"><span>読み込みに失敗しました</span></div>
          <div class="monthly-grid" style="padding: 40px; text-align: center; color: var(--color-text-muted); font-size: 0.9rem;">
            しばらく経ってから再度お試しください
          </div>
        </div>`;
      }
    }

    updateSlider();
  }

  bindNavigation();
  loadCalendar();
</script>

